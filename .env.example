# Copy to .env and fill in real values. Every variable used by the site is
# documented here and in README.md.

# --- Speaker Request form (spec §5) ---------------------------------------

# Resend API key for transactional email. Unset in dev = emails are skipped
# and the request is logged to the server console instead.
RESEND_API_KEY=

# Where speaker-request notifications are delivered (Ibrahim's designated
# inbox).
SPEAKER_NOTIFY_EMAIL=

# From address for both emails. Must be a verified sender/domain in Resend,
# e.g. "Ibrahim Awad <speaking@karateattorney.com>".
SPEAKER_FROM_EMAIL=

# Cloudflare Turnstile. The PUBLIC_ site key is inlined into the client at
# BUILD time; the secret is read at runtime. Unset = spam check disabled
# (dev only — always set both in production).
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# CRM handoff: n8n workflow / Google Sheet webhook that receives each
# request as JSON. Unset = handoff skipped (emails still send).
CRM_WEBHOOK_URL=

# --- Footer newsletter -----------------------------------------------------

# Form POST endpoint of the newsletter provider (build-time, public).
# Unset = the footer shows a disabled notice instead of the form.
PUBLIC_NEWSLETTER_ACTION=
