---
import { getCollection } from 'astro:content';
import PageIntro from '../../components/ui/PageIntro.astro';
import { HUB_CATEGORIES } from '../../content.config';
import BaseLayout from '../../layouts/BaseLayout.astro';

const entries = (await getCollection('hub', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const typeBadge: Record<string, string> = {
  video: 'Video',
  reel: 'Reel',
  article: 'Article',
};

const fmt = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<BaseLayout
  title="Content Hub"
  description="[PLACEHOLDER: content-hub meta description — videos, reels, and articles on law, motivation, and faith]"
>
  <PageIntro kicker="Content Hub" title="Watch. Read. Share.">
    Legal education, motivation, and faith — everything Ibrahim publishes, in
    one place.
  </PageIntro>

  <section class="wrap section-pad" aria-labelledby="hub-heading">
    <h2 id="hub-heading" class="sr-only">All content</h2>

    <div
      class="flex flex-wrap gap-2"
      role="group"
      aria-label="Filter by category"
      id="hub-filters"
    >
      <button
        type="button"
        data-filter="all"
        aria-pressed="true"
        class="rounded-full border-2 border-navy-900 bg-navy-900 px-5 py-2 text-sm font-bold text-paper transition-colors aria-[pressed=false]:bg-transparent aria-[pressed=false]:text-navy-900 hover:bg-navy-700 hover:text-paper"
      >
        All
      </button>
      {
        HUB_CATEGORIES.map((c) => (
          <button
            type="button"
            data-filter={c.value}
            aria-pressed="false"
            class="rounded-full border-2 border-navy-900 bg-navy-900 px-5 py-2 text-sm font-bold text-paper transition-colors aria-[pressed=false]:bg-transparent aria-[pressed=false]:text-navy-900 hover:bg-navy-700 hover:text-paper"
          >
            {c.label}
          </button>
        ))
      }
    </div>

    <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3" id="hub-grid">
      {
        entries.map((entry) => (
          <li data-category={entry.data.category}>
            <a
              href={`/content/${entry.id}`}
              class="group flex h-full flex-col rounded-2xl border border-ink/10 bg-white p-6 transition-colors hover:border-gold-500"
              data-reveal
            >
              <div class="flex items-center gap-2 text-xs font-bold tracking-wide uppercase">
                <span class="rounded-full bg-gold-100 px-2.5 py-1 text-gold-800">
                  {typeBadge[entry.data.type]}
                </span>
                <span class="text-ink/60">
                  {
                    HUB_CATEGORIES.find(
                      (c) => c.value === entry.data.category,
                    )?.label
                  }
                </span>
              </div>
              <h3 class="mt-4 font-display text-xl font-bold group-hover:text-navy-700">
                {entry.data.title}
              </h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-ink/70">
                {entry.data.description}
              </p>
              <p class="mt-4 text-xs text-ink/60">{fmt.format(entry.data.date)}</p>
            </a>
          </li>
        ))
      }
    </ul>

    <p
      id="hub-empty"
      hidden
      class="mt-10 rounded-2xl border border-dashed border-navy-300 p-8 text-center text-ink/60"
    >
      Nothing in this category yet — check back soon.
    </p>
  </section>
</BaseLayout>

<script>
  // Category filter (spec §3). Progressive enhancement: without JS every
  // entry is simply visible. Selected filter is mirrored to ?category= so
  // filtered views are shareable.
  const filters = document.getElementById('hub-filters');
  const cards = Array.from(
    document.querySelectorAll<HTMLElement>('#hub-grid > li'),
  );
  const empty = document.getElementById('hub-empty');

  function apply(filter: string) {
    let shown = 0;
    for (const card of cards) {
      const show = filter === 'all' || card.dataset.category === filter;
      card.hidden = !show;
      if (show) shown++;
    }
    if (empty) empty.hidden = shown > 0;
    filters
      ?.querySelectorAll<HTMLButtonElement>('button[data-filter]')
      .forEach((b) =>
        b.setAttribute('aria-pressed', String(b.dataset.filter === filter)),
      );
    const url = new URL(location.href);
    if (filter === 'all') url.searchParams.delete('category');
    else url.searchParams.set('category', filter);
    history.replaceState(null, '', url);
  }

  filters?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(
      'button[data-filter]',
    );
    if (btn?.dataset.filter) apply(btn.dataset.filter);
  });

  const initial = new URLSearchParams(location.search).get('category');
  if (initial) apply(initial);
</script>
