---
import { getCollection, render } from 'astro:content';
import PageIntro from '../../components/ui/PageIntro.astro';
import { HUB_CATEGORIES } from '../../content.config';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/ui/Button.astro';

export async function getStaticPaths() {
  const entries = await getCollection('hub', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const categoryLabel = HUB_CATEGORIES.find(
  (c) => c.value === entry.data.category,
)?.label;
const isPlayable =
  entry.data.type !== 'article' && !!entry.data.videoUrl;
const hasRealUrl = isPlayable && !entry.data.videoUrl!.startsWith('[');
const fmt = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <PageIntro kicker={categoryLabel ?? 'Content'} title={entry.data.title}>
    {entry.data.description}
  </PageIntro>

  <article class="wrap section-pad">
    <div class="mx-auto max-w-3xl">
      <p class="text-sm text-ink/50">{fmt.format(entry.data.date)}</p>

      {
        entry.data.type !== 'article' && (
          <div class="mt-8">
            {hasRealUrl ? (
              <Button href={entry.data.videoUrl} rel="noopener" variant="gold">
                Watch on the original platform →
              </Button>
            ) : (
              <div class="grid aspect-video place-items-center rounded-2xl border border-dashed border-navy-300 bg-navy-50 p-6 text-center">
                <p class="text-sm text-ink/60">
                  [PLACEHOLDER: video embed — set videoUrl in this entry&rsquo;s
                  frontmatter]
                </p>
              </div>
            )}
          </div>
        )
      }

      <div class="prose-custom mt-10 space-y-5 leading-relaxed">
        <Content />
      </div>

      <div class="mt-14 border-t border-ink/10 pt-8">
        <Button href="/content" variant="outline">← Back to the hub</Button>
      </div>
    </div>
  </article>
</BaseLayout>
