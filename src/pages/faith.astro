---
import ImagePlaceholder from '../components/ui/ImagePlaceholder.astro';
import PageIntro from '../components/ui/PageIntro.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
---

<BaseLayout
  title="Faith & Community"
  description="[PLACEHOLDER: faith meta description — khutbahs, Team Fajr, and community leadership]"
>
  <PageIntro kicker="Faith & Community" title="Faith is the throughline.">
    [PLACEHOLDER: faith-page intro — khateeb work, community leadership, and
    why it anchors everything else]
  </PageIntro>

  <section class="wrap section-pad">
    <div class="grid items-center gap-10 lg:grid-cols-2">
      <div data-reveal>
        <h2 class="text-display-lg">Khutbahs</h2>
        <p class="mt-5 leading-relaxed text-ink/75">
          [PLACEHOLDER: 1–2 paragraphs — Ibrahim as khateeb: where he
          delivers, recurring themes.]
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button href="/content?category=faith">Watch khutbahs in the hub</Button>
          <Button href="/speaking#request" variant="outline">
            Invite Ibrahim for jumu&rsquo;ah
          </Button>
        </div>
      </div>
      <ImagePlaceholder label="minbar / khutbah photo" ratio="4/3" data-reveal />
    </div>
  </section>

  <section class="on-dark bg-navy-900 text-paper">
    <div class="wrap section-pad">
      <div class="grid items-center gap-10 lg:grid-cols-2">
        <ImagePlaceholder
          label="Team Fajr photo"
          ratio="4/3"
          class="border-navy-600 bg-navy-800 [&_p]:text-navy-200"
          data-reveal
        />
        <div data-reveal>
          <h2 class="text-display-lg">Team Fajr</h2>
          <p class="mt-5 leading-relaxed text-navy-100">
            [PLACEHOLDER: what Team Fajr is — the practice, the brotherhood,
            how someone joins.]
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap section-pad">
    <div data-reveal>
      <h2 class="text-display-lg">Community leadership</h2>
      <p class="mt-5 max-w-2xl leading-relaxed text-ink/75">
        [PLACEHOLDER: community roles, organizations served, initiatives led —
        with links where they exist.]
      </p>
      <div class="mt-8">
        <Button href="/giving" variant="primary">Giving Back →</Button>
      </div>
    </div>
  </section>
</BaseLayout>
