---
import SpeakerForm from '../components/speaking/SpeakerForm.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { TOPICS } from '../lib/speaker-request';
import { FIRM_URL, SITE } from '../lib/site';
import Button from '../components/ui/Button.astro';

const audiences = [
  'Masjids & Islamic centers',
  'Islamic schools',
  'MSAs & universities',
  'Conferences & conventions',
  'Nonprofits & fundraisers',
  'Corporate & legal teams',
];

const presetTopics = TOPICS.filter((t) => t.value !== 'other');
---

<BaseLayout
  title="Speaking"
  description="[PLACEHOLDER: speaking meta description — book Ibrahim Awad for keynotes, khutbahs, workshops, and youth programs]"
>
  <Fragment slot="head">
    <JsonLd
      schema={{
        '@type': 'Service',
        serviceType: 'Public speaking',
        name: 'Speaking engagements with Ibrahim Awad',
        url: `${SITE.url}/speaking`,
        provider: {
          '@type': 'Person',
          name: SITE.person,
          alternateName: SITE.name,
          url: SITE.url,
          jobTitle: 'Trial lawyer',
          worksFor: {
            '@type': 'Organization',
            name: 'The Awad Law Firm',
            url: FIRM_URL,
          },
        },
      }}
    />
  </Fragment>
  <section class="on-dark bg-navy-950 text-paper">
    <div class="wrap section-pad">
      <p class="text-sm font-bold tracking-[0.25em] text-gold-300 uppercase" data-hero-line>
        Speaking
      </p>
      <h1 class="text-display-xl mt-4 max-w-4xl" data-hero-line>
        Talks that carry from the stage to the street.
      </h1>
      <p class="text-lede mt-6 max-w-2xl text-navy-100" data-hero-line>
        [PLACEHOLDER: speaking-page intro — 2–3 sentences on Ibrahim&rsquo;s
        speaking work, from TEDx to jumu&rsquo;ah khutbahs]
      </p>
      <div class="mt-9" data-hero-line>
        <Button href="#request" variant="gold" size="lg">
          Request Ibrahim as a speaker
        </Button>
      </div>
    </div>
  </section>

  <section class="wrap section-pad" aria-labelledby="reel-heading">
    <h2 id="reel-heading" class="text-display-lg" data-reveal>Watch first</h2>
    <div class="mt-10 grid gap-8 lg:grid-cols-2">
      <figure data-reveal>
        <div class="grid aspect-video place-items-center rounded-2xl border border-dashed border-navy-300 bg-navy-50 p-6 text-center">
          <p class="text-sm text-ink/60">
            [PLACEHOLDER: speaker reel — provide video file or YouTube/Vimeo
            link]
          </p>
        </div>
        <figcaption class="mt-3 text-sm font-semibold">Speaker reel</figcaption>
      </figure>
      <figure data-reveal data-reveal-delay="0.08">
        <div class="grid aspect-video place-items-center rounded-2xl border border-dashed border-navy-300 bg-navy-50 p-6 text-center">
          <p class="text-sm text-ink/60">
            [PLACEHOLDER: TEDx &ldquo;Beautiful Patience&rdquo; embed — provide
            the YouTube video ID]
          </p>
        </div>
        <figcaption class="mt-3 text-sm font-semibold">
          TEDx — Beautiful Patience
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="on-dark bg-navy-900 text-paper" aria-labelledby="topics-heading">
    <div class="wrap section-pad">
      <h2 id="topics-heading" class="text-display-lg" data-reveal>
        Signature topics
      </h2>
      <p class="mt-4 max-w-2xl text-navy-100" data-reveal>
        Every talk is adapted to the room — these are the messages Ibrahim is
        asked for most.
      </p>
      <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          presetTopics.map((t, i) => (
            <li
              data-reveal
              data-reveal-delay={String((i % 3) * 0.07)}
              class="rounded-2xl border border-navy-700 bg-navy-800/60 p-6"
            >
              <h3 class="font-display text-xl font-bold text-gold-300">
                {t.label}
              </h3>
              <p class="mt-2 text-sm text-navy-100">
                [PLACEHOLDER: one-sentence description of this talk]
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="wrap section-pad" aria-labelledby="audiences-heading">
    <div class="grid gap-12 lg:grid-cols-2">
      <div data-reveal>
        <h2 id="audiences-heading" class="text-display-lg">Who books Ibrahim</h2>
        <ul class="mt-8 space-y-3">
          {
            audiences.map((a) => (
              <li class="flex items-center gap-3 font-medium">
                <span class="h-2 w-2 rounded-full bg-gold-500" aria-hidden="true" />
                {a}
              </li>
            ))
          }
        </ul>
      </div>
      <div data-reveal data-reveal-delay="0.08">
        <h2 class="text-display-lg">Said about Ibrahim</h2>
        <div class="mt-8 space-y-6">
          <blockquote class="rounded-2xl border border-dashed border-navy-300 bg-navy-50 p-6 text-sm text-ink/60">
            [PLACEHOLDER: testimonial 1 — quote, name, role, organization]
          </blockquote>
          <blockquote class="rounded-2xl border border-dashed border-navy-300 bg-navy-50 p-6 text-sm text-ink/60">
            [PLACEHOLDER: testimonial 2 — quote, name, role, organization]
          </blockquote>
        </div>
        <h2 class="text-display-md mt-12">Past venues</h2>
        <p class="mt-4 rounded-2xl border border-dashed border-navy-300 bg-navy-50 p-6 text-sm text-ink/60">
          [PLACEHOLDER: list of past venues / organizations / logos]
        </p>
      </div>
    </div>
  </section>

  <SpeakerForm />
</BaseLayout>
