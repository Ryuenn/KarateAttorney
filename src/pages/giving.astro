---
import ImagePlaceholder from '../components/ui/ImagePlaceholder.astro';
import PageIntro from '../components/ui/PageIntro.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';

const initiatives = [
  {
    title: '[PLACEHOLDER: initiative 1 name]',
    body: '[PLACEHOLDER: initiative 1 — what it does, who it serves]',
  },
  {
    title: '[PLACEHOLDER: initiative 2 name]',
    body: '[PLACEHOLDER: initiative 2 — what it does, who it serves]',
  },
  {
    title: '[PLACEHOLDER: initiative 3 name]',
    body: '[PLACEHOLDER: initiative 3 — what it does, who it serves]',
  },
];
---

<BaseLayout
  title="Giving Back"
  description="[PLACEHOLDER: giving meta description — philanthropy and community initiatives]"
>
  <PageIntro kicker="Giving Back" title="Success is a trust.">
    [PLACEHOLDER: giving intro — the philosophy behind the philanthropy]
  </PageIntro>

  <section class="wrap section-pad">
    <div class="grid gap-6 sm:grid-cols-3">
      {
        initiatives.map((init, i) => (
          <div
            class="rounded-2xl border border-ink/10 bg-white p-8"
            data-reveal
            data-reveal-delay={String(i * 0.07)}
          >
            <h2 class="font-display text-xl font-bold">{init.title}</h2>
            <p class="mt-3 text-sm leading-relaxed text-ink/70">{init.body}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-16 grid items-center gap-10 lg:grid-cols-2">
      <ImagePlaceholder label="community initiative photo" ratio="16/9" data-reveal />
      <div data-reveal>
        <h2 class="text-display-lg">Partner on the next one</h2>
        <p class="mt-5 leading-relaxed text-ink/75">
          [PLACEHOLDER: how organizations can partner on community initiatives]
        </p>
        <div class="mt-8">
          <Button href="/contact" variant="primary">Get in touch</Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
