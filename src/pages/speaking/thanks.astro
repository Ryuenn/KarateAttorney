---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/ui/Button.astro';
---

<BaseLayout
  title="Request received"
  description="Your speaker request has been received."
  noindex
>
  <section class="wrap section-pad">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-sm font-bold tracking-[0.25em] text-gold-600 uppercase">
        Speaker request
      </p>
      <h1 class="text-display-xl mt-4">JazakAllah khair — it&rsquo;s in.</h1>
      <p class="text-lede mt-6 text-ink/70">
        Your request has been received and a confirmation email is on its way.
        Someone will follow up personally to talk details.
      </p>
      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <Button href="/content">Explore the Content Hub</Button>
        <Button href="/" variant="outline">Back to home</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Primary KPI (spec §5/§6): fire the conversion exactly once per
  // submission, through the shared provider-agnostic tracker.
  import { track } from '../../scripts/analytics';

  const KEY = 'ka-speaker-conversion-fired';
  if (!sessionStorage.getItem(KEY)) {
    sessionStorage.setItem(KEY, '1');
    track('speaker_request_submitted');
  }
</script>
