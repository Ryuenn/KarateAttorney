---
import PageIntro from '../components/ui/PageIntro.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { FIRM_URL } from '../lib/site';

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
const inputClass =
  'w-full rounded-xl border border-navy-200 bg-white px-4 py-3 text-ink placeholder:text-ink/40 focus:border-navy-500';
const labelClass = 'mb-1.5 block text-sm font-semibold text-navy-900';
---

<BaseLayout
  title="Contact"
  description="[PLACEHOLDER: contact meta description — reach Ibrahim for speaking, media, or general inquiries]"
>
  <PageIntro kicker="Contact" title="Start in the right lane.">
    Three doors — pick the one that fits so your message lands in the right
    inbox the first time.
  </PageIntro>

  <section class="wrap section-pad" aria-labelledby="triage-heading">
    <h2 id="triage-heading" class="sr-only">Choose your inquiry type</h2>
    <div class="grid gap-6 lg:grid-cols-3">
      <a
        href={FIRM_URL}
        data-firm-link
        class="group rounded-2xl border-2 border-gold-500 bg-gold-50 p-8 transition-colors hover:bg-gold-100"
      >
        <p class="text-sm font-bold tracking-widest text-gold-700 uppercase">
          I need a lawyer
        </p>
        <h3 class="text-display-md mt-3">Injury case? Straight to the firm.</h3>
        <p class="mt-3 text-sm leading-relaxed text-ink/70">
          Legal inquiries are handled at The Awad Law Firm — you&rsquo;ll get
          the intake team, not a website inbox.
          <span lang="es" class="mt-1 block">
            ¿Lesionado? Visite The Awad Law Firm.
          </span>
        </p>
        <p class="mt-6 font-display font-bold text-gold-700">
          Go to theawadlawfirm.com →
        </p>
      </a>

      <a
        href="/speaking#request"
        class="group rounded-2xl border-2 border-navy-900 bg-navy-950 p-8 text-paper transition-colors hover:bg-navy-900 on-dark"
      >
        <p class="text-sm font-bold tracking-widest text-gold-300 uppercase">
          Book Ibrahim to speak
        </p>
        <h3 class="text-display-md mt-3">Invite him to your stage.</h3>
        <p class="mt-3 text-sm leading-relaxed text-navy-100">
          Keynotes, khutbahs, workshops, youth programs — the speaker request
          form takes two minutes.
        </p>
        <p class="mt-6 font-display font-bold text-gold-300">
          Open the speaker form →
        </p>
      </a>

      <a
        href="#general-form"
        class="group rounded-2xl border-2 border-ink/15 bg-white p-8 transition-colors hover:border-navy-500"
      >
        <p class="text-sm font-bold tracking-widest text-navy-500 uppercase">
          Other
        </p>
        <h3 class="text-display-md mt-3">Everything else.</h3>
        <p class="mt-3 text-sm leading-relaxed text-ink/70">
          Media, partnerships, Palistory, Awad Academy, or something that
          doesn&rsquo;t fit a box.
        </p>
        <p class="mt-6 font-display font-bold text-navy-700">
          Use the general form ↓
        </p>
      </a>
    </div>
  </section>

  <section id="general-form" class="scroll-mt-24 bg-navy-50" aria-labelledby="general-heading">
    <div class="wrap section-pad">
      <div class="mx-auto max-w-2xl">
        <h2 id="general-heading" class="text-display-lg">General inquiries</h2>
        <p class="mt-4 text-ink/70">
          Not legal, not speaking — everything else lands here.
        </p>

        <div
          id="contact-error"
          role="alert"
          hidden
          class="mt-6 rounded-xl border border-red-300 bg-red-50 p-4 text-sm font-medium text-red-900"
        >
        </div>

        <form method="post" action="/api/contact" class="mt-8 space-y-5">
          <div class="hidden" aria-hidden="true">
            <label>
              Website
              <input type="text" name="website" tabindex="-1" autocomplete="off" />
            </label>
          </div>
          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label class={labelClass} for="name">Name</label>
              <input id="name" name="name" required autocomplete="name" class={inputClass} />
            </div>
            <div>
              <label class={labelClass} for="email">Email</label>
              <input id="email" type="email" name="email" required autocomplete="email" class={inputClass} />
            </div>
          </div>
          <div>
            <label class={labelClass} for="subject">
              Subject <span class="font-normal text-ink/60">(optional)</span>
            </label>
            <input id="subject" name="subject" maxlength="200" class={inputClass} />
          </div>
          <div>
            <label class={labelClass} for="message">Message</label>
            <textarea id="message" name="message" rows="5" required maxlength="5000" class={inputClass}></textarea>
          </div>

          {
            turnstileSiteKey ? (
              <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="light" />
            ) : (
              <p class="rounded-xl border border-dashed border-navy-300 p-4 text-xs text-ink/60">
                Spam protection is not active: set
                <code>PUBLIC_TURNSTILE_SITE_KEY</code> and
                <code>TURNSTILE_SECRET_KEY</code> to enable Cloudflare
                Turnstile.
              </p>
            )
          }

          <button
            type="submit"
            class="w-full rounded-full bg-navy-900 px-8 py-4 font-display text-lg font-bold text-paper transition-colors hover:bg-navy-700 sm:w-auto"
          >
            Send message
          </button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

{turnstileSiteKey && (
  <script
    is:inline
    src="https://challenges.cloudflare.com/turnstile/v0/api.js"
    async
    defer></script>
)}

<script>
  const messages: Record<string, string> = {
    validation:
      'Some fields were missing or invalid — please review and send again.',
    turnstile:
      'The spam check could not verify your submission — please try again.',
    delivery:
      'Your message could not be sent right now — please try again shortly.',
    'bad-request': 'The submission could not be read — please try again.',
  };
  const code = new URLSearchParams(location.search).get('error');
  const banner = document.getElementById('contact-error');
  if (code && banner) {
    banner.textContent = messages[code] ?? messages['bad-request'];
    banner.hidden = false;
  }
</script>
