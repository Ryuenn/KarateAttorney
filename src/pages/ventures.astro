---
import PageIntro from '../components/ui/PageIntro.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { FIRM_URL, VENTURES } from '../lib/site';

const ventures = [
  {
    name: 'The Awad Law Firm',
    href: FIRM_URL,
    firm: true,
    blurb:
      '[PLACEHOLDER: one-paragraph description — the injury law firm Ibrahim founded]',
  },
  {
    name: 'Palistory',
    href: VENTURES.palistory,
    firm: false,
    blurb:
      '[PLACEHOLDER: one-paragraph description — Palestinian memory and storytelling]',
  },
  {
    name: 'Awad Academy',
    href: VENTURES.awadAcademy,
    firm: false,
    blurb: '[PLACEHOLDER: one-paragraph description — what Awad Academy teaches]',
  },
  {
    name: 'Team Karate Attorney',
    href: VENTURES.teamKarateAttorney,
    firm: false,
    blurb:
      '[PLACEHOLDER: one-paragraph description — the training team and community]',
  },
];
---

<BaseLayout
  title="Ventures"
  description="[PLACEHOLDER: ventures meta description — Palistory, Awad Academy, Team Karate Attorney, and The Awad Law Firm]"
>
  <PageIntro kicker="Ventures" title="Built to serve, built to last.">
    [PLACEHOLDER: ventures intro — the why behind the portfolio]
  </PageIntro>

  <section class="wrap section-pad">
    <div class="grid gap-6 sm:grid-cols-2">
      {
        ventures.map((v, i) => (
          <a
            href={v.href}
            rel="noopener"
            data-firm-link={v.firm || undefined}
            data-reveal
            data-reveal-delay={String((i % 2) * 0.08)}
            class="group flex flex-col rounded-2xl border border-ink/10 bg-white p-8 transition-colors hover:border-gold-500"
          >
            <h2 class="text-display-md group-hover:text-navy-700">{v.name}</h2>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-ink/70">{v.blurb}</p>
            <p class="mt-6 font-display text-sm font-bold text-gold-600">
              Visit →
            </p>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
