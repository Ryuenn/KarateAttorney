---
import PageBand from '../components/layout/PageBand.astro';
import LogoMarquee from '../components/layout/LogoMarquee.astro';
import PageCards from '../components/layout/PageCards.astro';
import PageClosing from '../components/layout/PageClosing.astro';
import PageFaq from '../components/layout/PageFaq.astro';
import PageFeature from '../components/layout/PageFeature.astro';
import PageHero from '../components/layout/PageHero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { FIRM_URL } from '../lib/site';
---

<BaseLayout
  title="The Attorney"
  description="Ibrahim Awad, trial lawyer — the values behind the practice. Injury cases are handled through The Awad Law Firm."
  heroOverlap
>
  <PageHero
    kicker="The Attorney"
    word1="The"
    word2="Courtroom"
    lede="Where preparation meets pressure. More than $60 million recovered for clients across Georgia, by a lawyer who spent the first half of his career on the other side of the aisle — and knows exactly how the state builds a case."
    image="/ibrahim-10.png"
    imageAlt="Ibrahim J. Awad seated at his desk, hands clasped, with law books and a set of scales behind him"
    {/* Biased up: the frame goes as wide as ~1.8:1 on short 2xl windows,
        which crops top and bottom — centring would clip the top of his head.
        The desk edge is the expendable part. */}
    imagePosition="object-[center_30%]"
    actions={[
      { label: 'Need Legal Help?', href: FIRM_URL, primary: true, firm: true },
    ]}
  />

  <PageBand
    heading={'What a client is\nreally hiring'}
    body="An insurance company runs the numbers on opposing counsel long before it runs them on your injury. It knows which lawyers file, posture, and settle — and it prices accordingly. Ibrahim built his practice to be the other kind of file on that desk: prepared early, documented thoroughly, and genuinely willing to try the case. He prosecuted more than 100 felonies as an assistant district attorney before he ever represented an injured client, which means trial is not a threat he makes — it is a room he has already lived in. More than $60 million recovered since says the approach holds."
    marquee="The Awad Law Firm"
  />

  <PageCards
    cards={[
      {
        title: 'Practice Areas',
        body: 'Personal injury, medical malpractice, wrongful death, and rideshare accident claims — all handled through The Awad Law Firm, where intake and case detail live. Consultations cost nothing.',
        href: FIRM_URL,
        linkLabel: 'Go to the firm',
        firm: true,
        image: '/practice-areas.png',
        imageAlt:
          'A case file, pen, gavel and a personal injury law volume on a desk, with a set of brass scales behind them',
        // 3:2 photo in a 16:9 frame — centring would shave the top of the
        // scales. Biased up; the empty desk edge takes the crop instead.
        imagePosition: 'object-[center_30%]',
      },
      {
        title: 'How a Case Moves',
        body: 'What actually happens between the crash and the resolution — investigation, treatment, demand, negotiation, and the point where filing suit becomes the right call.',
        href: '#',
        image: '/howcasemoves.png',
        imageAlt:
          'A case timeline laid out on a clipboard, beside stacked personal injury law volumes, a case file and brass scales',
      },
      {
        title: 'Know Your Rights',
        body: 'What to do at the scene, what never to say to an adjuster, and the deadlines that quietly decide cases before anyone reaches a courtroom.',
        href: '#',
        image: '/adjuster.png',
        imageAlt:
          'A "Your Rights" checklist on a clipboard covering the scene, adjuster calls and filing deadlines, beside a desk calendar and brass scales',
      },
    ]}
  />

  <PageFeature
    heading={'Injured? Start\nwith a conversation'}
    body="Case intake, practice areas, and the details of how the firm works all live at The Awad Law Firm. Consultations cost nothing, there is no fee unless the case is won, and the deadlines that matter start running from the day of the injury — not the day you decide to call."
    ctaLabel="Go to The Awad Law Firm"
    ctaHref={FIRM_URL}
    firm
    image="/ibrahim-11.png"
    imageAlt="Ibrahim J. Awad in a long black overcoat, fists raised in a fighting guard, against a gold-streaked backdrop"
  />

  <PageFaq
    ctaLabel="Go to the firm"
    ctaHref={FIRM_URL}
    items={[
      {
        q: 'What does a consultation cost?',
        a: 'Nothing. Injury consultations through The Awad Law Firm are free, and the firm works on a contingency basis — no fee unless the case is won.',
      },
      {
        q: 'How long do I have to file?',
        a: 'Less time than most people assume, and the clock starts at the injury rather than the day you decide to act. Ask early — the answer depends on the type of claim.',
      },
      {
        q: 'Should I talk to the insurance adjuster?',
        a: 'Not before you have spoken to a lawyer. A recorded statement given in good faith on day two is routinely used to reduce what you are owed months later.',
      },
      {
        q: 'Will my case actually go to trial?',
        a: 'Most resolve before that. But cases settle well precisely because the other side believes you are prepared to try them — that willingness is the leverage.',
      },
    ]}
  />

  <LogoMarquee />

  <PageClosing
    marquee="Injured? Talk to Ibrahim"
    prompt="Consultations are free, and there is no fee unless the case is won."
    primary={{ label: 'Go to The Awad Law Firm', href: FIRM_URL, firm: true }}
    secondary={{ label: 'Book Ibrahim to Speak', href: '/speaking' }}
    image="/ibrahim-9.png"
    imageAlt="Ibrahim J. Awad, arms folded, in a studio portrait"
  />
</BaseLayout>
