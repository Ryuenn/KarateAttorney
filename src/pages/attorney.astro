---
import ImagePlaceholder from '../components/ui/ImagePlaceholder.astro';
import PageIntro from '../components/ui/PageIntro.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { FIRM_URL } from '../lib/site';
import Button from '../components/ui/Button.astro';

const values = [
  {
    title: 'Fight for people',
    body: '[PLACEHOLDER: value statement — what representing injured people means to Ibrahim]',
  },
  {
    title: 'Prepared like a fighter',
    body: '[PLACEHOLDER: value statement — trial preparation, discipline from training]',
  },
  {
    title: 'Faith-guided practice',
    body: '[PLACEHOLDER: value statement — integrity and service in the law]',
  },
];
---

<BaseLayout
  title="The Attorney"
  description="[PLACEHOLDER: attorney meta description — Ibrahim Awad, trial lawyer and founder of The Awad Law Firm]"
>
  <PageIntro kicker="The Attorney" title="A trial lawyer in your corner.">
    [PLACEHOLDER: attorney-page intro — who Ibrahim is as a lawyer; biography
    and values only. Practice-area details live on the firm site.]
    <Fragment slot="actions">
      <div class="mt-9 flex flex-wrap gap-3">
        <Button href={FIRM_URL} variant="gold" size="lg" data-firm-link>
          Hire Ibrahim → The Awad Law Firm
        </Button>
      </div>
      <p class="mt-3 text-xs text-navy-200" lang="es">
        ¿Lesionado? Visite The Awad Law Firm
      </p>
    </Fragment>
  </PageIntro>

  <section class="wrap section-pad">
    <div class="grid items-center gap-10 lg:grid-cols-2">
      <ImagePlaceholder label="courtroom / professional portrait" ratio="4/5" data-reveal />
      <div data-reveal>
        <h2 class="text-display-lg">Why they call him The Karate Attorney</h2>
        <p class="mt-5 leading-relaxed text-ink/75">
          [PLACEHOLDER: 2–3 paragraphs — biography of the attorney: the road
          to trial law, founding the firm, how he shows up for clients.]
        </p>
      </div>
    </div>

    <div class="mt-20 grid gap-6 sm:grid-cols-3">
      {
        values.map((v, i) => (
          <div
            class="rounded-2xl border border-ink/10 bg-white p-8"
            data-reveal
            data-reveal-delay={String(i * 0.07)}
          >
            <h3 class="font-display text-xl font-bold">{v.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-ink/70">{v.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="bg-gold-400 text-navy-950">
    <div class="wrap flex flex-col items-start justify-between gap-6 py-14 lg:flex-row lg:items-center">
      <div data-reveal>
        <h2 class="text-display-md">Have a case? Talk to the firm.</h2>
        <p class="mt-2 max-w-xl font-medium">
          All legal inquiries and cases are handled at The Awad Law Firm.
        </p>
      </div>
      <Button href={FIRM_URL} variant="primary" size="lg" data-firm-link data-reveal>
        Go to The Awad Law Firm →
      </Button>
    </div>
  </section>
</BaseLayout>
