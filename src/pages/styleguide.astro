---
import { Font } from 'astro:assets';
import Button from '../components/ui/Button.astro';
import '../styles/global.css';

const navySteps = [
  '50', '100', '200', '300', '400', '500', '600', '700', '800', '900', '950',
];
const goldSteps = [
  '50', '100', '200', '300', '400', '500', '600', '700', '800', '900',
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Style reference — The Karate Attorney</title>
    <meta name="robots" content="noindex" />
    <Font cssVariable="--font-archivo" preload />
    <Font cssVariable="--font-inter" preload />
  </head>
  <body>
    <main class="wrap section-pad space-y-20">
      <header>
        <p class="text-sm font-semibold tracking-widest text-navy-500 uppercase">
          Internal style reference
        </p>
        <h1 class="text-display-xl mt-2">Navy &amp; Gold</h1>
        <p class="text-lede mt-4 max-w-2xl text-navy-700">
          Design tokens for karateattorney.com — palette, fluid type scale,
          buttons, and rhythm. This page is noindexed and exists for review.
        </p>
      </header>

      <section aria-labelledby="palette">
        <h2 id="palette" class="text-display-md mb-6">Palette</h2>
        <div class="space-y-6">
          <div>
            <h3 class="mb-2 font-semibold">navy</h3>
            <div class="grid grid-cols-4 gap-2 sm:grid-cols-6 lg:grid-cols-11">
              {navySteps.map((s) => (
                <div>
                  <div
                    class="h-14 rounded-md border border-ink/10"
                    style={`background-color: var(--color-navy-${s})`}
                  >
                  </div>
                  <p class="mt-1 text-xs text-ink/60">{s}</p>
                </div>
              ))}
            </div>
          </div>
          <div>
            <h3 class="mb-2 font-semibold">gold</h3>
            <div class="grid grid-cols-4 gap-2 sm:grid-cols-6 lg:grid-cols-10">
              {goldSteps.map((s) => (
                <div>
                  <div
                    class="h-14 rounded-md border border-ink/10"
                    style={`background-color: var(--color-gold-${s})`}
                  >
                  </div>
                  <p class="mt-1 text-xs text-ink/60">{s}</p>
                </div>
              ))}
            </div>
          </div>
          <div class="grid grid-cols-2 gap-2 sm:max-w-xs">
            <div>
              <div class="h-14 rounded-md bg-ink"></div>
              <p class="mt-1 text-xs text-ink/60">ink</p>
            </div>
            <div>
              <div class="h-14 rounded-md border border-ink/10 bg-paper"></div>
              <p class="mt-1 text-xs text-ink/60">paper</p>
            </div>
          </div>
        </div>
      </section>

      <section aria-labelledby="type">
        <h2 id="type" class="text-display-md mb-6">Type scale (fluid)</h2>
        <div class="space-y-8">
          <p class="text-display-2xl">Keep Your Hands Up</p>
          <p class="text-display-xl">Beautiful Patience</p>
          <p class="text-display-lg">Facts inform, stories transform</p>
          <p class="text-display-md">The Muslim Professional</p>
          <p class="text-lede max-w-2xl">
            Lede — [PLACEHOLDER: sample body copy]. Body text is Inter with a
            1.55 line height for long-form reading; display is Archivo, tight
            and confident, sized with clamp() so it scales fluidly.
          </p>
          <p class="max-w-2xl">
            Body — [PLACEHOLDER: sample body copy]. Both faces are self-hosted
            at build time and are placeholder choices until final brand
            typography is confirmed.
          </p>
        </div>
      </section>

      <section aria-labelledby="buttons">
        <h2 id="buttons" class="text-display-md mb-6">Buttons</h2>
        <div class="flex flex-wrap items-center gap-4">
          <Button>Book Ibrahim to Speak</Button>
          <Button variant="gold">Need a Lawyer?</Button>
          <Button variant="outline">Watch the TEDx talk</Button>
        </div>
        <div class="mt-6 flex flex-wrap items-center gap-4 rounded-2xl bg-navy-950 p-8 on-dark">
          <Button variant="light">Book Ibrahim to Speak</Button>
          <Button variant="gold">Need a Lawyer?</Button>
          <Button variant="outline" class="text-paper">Watch the TEDx talk</Button>
        </div>
      </section>

      <section aria-labelledby="contrast">
        <h2 id="contrast" class="text-display-md mb-6">Contrast pairs (AA)</h2>
        <div class="grid gap-4 sm:grid-cols-3">
          <div class="rounded-xl bg-navy-950 p-6">
            <p class="font-display text-xl font-bold text-gold-400">
              Gold 400 on navy 950
            </p>
            <p class="mt-1 text-sm text-navy-100">≈ 8.6:1</p>
          </div>
          <div class="rounded-xl bg-navy-900 p-6">
            <p class="font-display text-xl font-bold text-paper">
              Paper on navy 900
            </p>
            <p class="mt-1 text-sm text-navy-100">≈ 15:1</p>
          </div>
          <div class="rounded-xl bg-gold-400 p-6">
            <p class="font-display text-xl font-bold text-navy-950">
              Navy 950 on gold 400
            </p>
            <p class="mt-1 text-sm text-navy-800">≈ 9:1</p>
          </div>
        </div>
      </section>
    </main>
  </body>
</html>
