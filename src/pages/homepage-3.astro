---
import { Font } from 'astro:assets';
import ClosingCta from '../components/home/ClosingCta.astro';
import Hero3 from '../components/home/Hero3.astro';
import Measure from '../components/home/Measure.astro';
import SelectedWork from '../components/home/SelectedWork.astro';
import Services from '../components/home/Services.astro';
import Testimonials from '../components/home/Testimonials.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

// Homepage 3 keeps its own two-tier navbar (bareChrome), so the hero-cover
// pin used on HP1/HP2 is skipped here — HP3's navbar, hero, and practice
// cards are one combined block and the hero simply scrolls. It still gets
// the full below-hero section set and the shared footer curtain-reveal
// (footerReveal opts the shared footer back in under bareChrome).
---

<BaseLayout
  title="Homepage 3"
  description="Homepage design variant 3 (in progress)."
  bareChrome
  footerReveal
  noindex
>
  <Font slot="head" cssVariable="--font-cormorant" preload />
  <Hero3 />
  <SelectedWork />
  <Services />
  <Measure />
  <Testimonials />
  <ClosingCta />
</BaseLayout>
