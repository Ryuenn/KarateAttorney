---
import Arenas from '../components/home/Arenas.astro';
import Hero from '../components/home/Hero.astro';
import EvolvingEnergy from '../components/home/EvolvingEnergy.astro';
import Introduction from '../components/home/Introduction.astro';
import MeasureMotion from '../components/home/MeasureMotion.astro';
import Method from '../components/home/Method.astro';
import ChatWidget from '../components/layout/ChatWidget.astro';
import FloatingCta from '../components/layout/FloatingCta.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { FIRM_URL, SITE } from '../lib/site';

// Below-hero sections follow the editorial reference direction: alternating
// navy/paper bands, oversized uppercase section heads with a kicker rule and
// trailing meta line, and offset cards whose captions overlap the image.
---

<BaseLayout
  title="The Karate Attorney"
  description="Ibrahim Awad — trial lawyer, martial artist, and TEDx speaker. The discipline of the mat and the fight of the courtroom. Injury cases via The Awad Law Firm."
  heroOverlap
  footerReveal
>
  <Fragment slot="head">
    <JsonLd
      schema={{
        '@type': 'Person',
        name: SITE.person,
        alternateName: SITE.name,
        url: SITE.url,
        jobTitle: 'Trial lawyer',
        worksFor: {
          '@type': 'Organization',
          name: 'The Awad Law Firm',
          url: FIRM_URL,
        },
      }}
    />
  </Fragment>
  {/* Scroll-cover reveal: the hero is pinned by `position: sticky` at the
      top of the page while the sections below — lifted into their own
      stacking context by .hero-cover — scroll up and over it. Pure CSS, so
      it degrades to a normal stacked page without JS. */}
  <div class="hero-sticky">
    <Hero />
  </div>

  <div class="hero-cover">
    <Introduction />
    <EvolvingEnergy />
    <Arenas />
    <Method />
    <MeasureMotion />
  </div>

  {/* Opposite corners: the firm CTA sits lower-left, the chat lower-right.
      Both dock above the footer bar via the same helper. */}
  <FloatingCta />
  <ChatWidget />
</BaseLayout>
