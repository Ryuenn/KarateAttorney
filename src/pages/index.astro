---
import Hero from '../components/home/Hero.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { FIRM_URL, SITE } from '../lib/site';
import Button from '../components/ui/Button.astro';

const pillars = [
  {
    title: 'The Attorney',
    href: '/attorney',
    blurb:
      '[PLACEHOLDER: 1–2 sentences — trial lawyer, founder of The Awad Law Firm]',
  },
  {
    title: 'The Martial Artist',
    href: '/martial-artist',
    blurb:
      '[PLACEHOLDER: 1–2 sentences — training story, Team Karate Attorney]',
  },
  {
    title: 'The Speaker',
    href: '/speaking',
    blurb:
      '[PLACEHOLDER: 1–2 sentences — TEDx, khutbahs, keynotes, youth programs]',
  },
  {
    title: 'Faith & Community',
    href: '/faith',
    blurb: '[PLACEHOLDER: 1–2 sentences — faith, Team Fajr, community work]',
  },
];
---

<BaseLayout
  title="The Karate Attorney"
  description="[PLACEHOLDER: home meta description — Ibrahim Awad: trial lawyer, martial artist, TEDx speaker]"
  heroOverlap
>
  <Fragment slot="head">
    <JsonLd
      schema={{
        '@type': 'Person',
        name: SITE.person,
        alternateName: SITE.name,
        url: SITE.url,
        jobTitle: 'Trial lawyer',
        worksFor: {
          '@type': 'Organization',
          name: 'The Awad Law Firm',
          url: FIRM_URL,
        },
      }}
    />
  </Fragment>
  <Hero />

  <section class="wrap section-pad" aria-labelledby="pillars-heading">
    <h2 id="pillars-heading" class="text-display-lg max-w-3xl" data-reveal>
      One man. <span class="text-gold-700">Four arenas.</span>
    </h2>
    <div class="mt-12 grid gap-6 sm:grid-cols-2">
      {
        pillars.map((p, i) => (
          <a
            href={p.href}
            data-reveal
            data-reveal-delay={String((i % 2) * 0.08)}
            class="group rounded-2xl border border-ink/10 bg-white p-8 transition-colors hover:border-gold-500"
          >
            <h3 class="text-display-md group-hover:text-navy-700">{p.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-ink/70">{p.blurb}</p>
            <p class="mt-6 font-display text-sm font-bold text-gold-700">
              Explore →
            </p>
          </a>
        ))
      }
    </div>
  </section>

  <section class="on-dark bg-navy-950 text-paper" aria-labelledby="speak-heading">
    <div class="wrap section-pad">
      <div class="max-w-3xl" data-reveal>
        <p class="text-sm font-bold tracking-[0.25em] text-gold-300 uppercase">
          Speaking
        </p>
        <h2 id="speak-heading" class="text-display-xl mt-4">
          Bring a message that moves people.
        </h2>
        <p class="text-lede mt-6 text-navy-100">
          Keynotes, jumu&rsquo;ah khutbahs, workshops, and youth programs — for
          masjids, Islamic schools, MSAs, conferences, and beyond.
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          <Button href="/speaking#request" variant="gold" size="lg">
            Book Ibrahim to Speak
          </Button>
          <Button href="/speaking" variant="outline" size="lg" class="text-paper">
            Explore topics
          </Button>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-gold-400 text-navy-950" aria-labelledby="firm-heading">
    <div class="wrap flex flex-col items-start justify-between gap-6 py-14 lg:flex-row lg:items-center">
      <div data-reveal>
        <h2 id="firm-heading" class="text-display-md">
          Here about an injury case?
        </h2>
        <p class="mt-2 max-w-xl font-medium">
          Legal clients are served at The Awad Law Firm — go straight there.
          <span lang="es" class="mt-1 block text-sm font-normal">
            ¿Lesionado? Visite The Awad Law Firm.
          </span>
        </p>
      </div>
      <Button href={FIRM_URL} variant="primary" size="lg" data-firm-link data-reveal>
        Go to The Awad Law Firm →
      </Button>
    </div>
  </section>

  <section class="wrap section-pad" aria-labelledby="content-heading">
    <div class="flex flex-col justify-between gap-6 sm:flex-row sm:items-end" data-reveal>
      <div>
        <h2 id="content-heading" class="text-display-lg">Latest from the hub</h2>
        <p class="mt-3 max-w-xl text-ink/70">
          Legal education, motivation, and faith — videos, reels, and
          reflections in one place.
        </p>
      </div>
      <Button href="/content" variant="primary">Visit the Content Hub</Button>
    </div>
  </section>
</BaseLayout>
