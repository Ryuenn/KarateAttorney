---
import Hero from '../components/home/Hero.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { FIRM_URL, SITE } from '../lib/site';

// Homepage-variant phase: hero only. The former below-hero sections
// (pillars, speaking band, firm-routing band, hub teaser) live in git
// history and return once a design direction is chosen.
---

<BaseLayout
  title="The Karate Attorney"
  description="[PLACEHOLDER: home meta description — Ibrahim Awad: trial lawyer, martial artist, TEDx speaker]"
  heroOverlap
>
  <Fragment slot="head">
    <JsonLd
      schema={{
        '@type': 'Person',
        name: SITE.person,
        alternateName: SITE.name,
        url: SITE.url,
        jobTitle: 'Trial lawyer',
        worksFor: {
          '@type': 'Organization',
          name: 'The Awad Law Firm',
          url: FIRM_URL,
        },
      }}
    />
  </Fragment>
  <Hero />
</BaseLayout>
