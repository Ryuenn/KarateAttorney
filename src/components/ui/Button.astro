---
/**
 * Shared CTA button. Renders <a> when `href` is set, <button> otherwise.
 *
 * Variants:
 *  - primary  navy solid — default action on light surfaces
 *  - gold     the distinct "Need a Lawyer?" treatment (spec §3)
 *  - light    paper solid — primary action on navy surfaces
 *  - outline  current-color outline, works on light or dark
 */
interface Props {
  href?: string;
  variant?: 'primary' | 'gold' | 'light' | 'outline';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  [key: string]: unknown;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  class: className = '',
  ...rest
} = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 rounded-full font-display font-bold tracking-tight transition-[background-color,color,transform] duration-200 ease-(--ease-smooth) select-none active:scale-[0.98]';

const variants = {
  primary: 'bg-navy-900 text-paper hover:bg-navy-700',
  gold: 'bg-gold-400 text-navy-950 hover:bg-gold-300',
  light: 'bg-paper text-navy-950 hover:bg-gold-100',
  outline:
    'border-2 border-current text-current hover:bg-current/10',
};

const sizes = {
  sm: 'px-4 py-2 text-sm',
  md: 'px-6 py-3 text-base',
  lg: 'px-8 py-4 text-lg',
};

const classes = [base, variants[variant], sizes[size], className].join(' ');
const Tag = href ? 'a' : 'button';
---

<Tag class={classes} href={href} {...rest}><slot /></Tag>
