---
/**
 * /contact — the message form, replacing the three placeholder-photo columns
 * that used to sit here.
 *
 * Two columns on desktop: the routing rules and direct addresses on the left,
 * the form itself on the right. The left column is not decoration — the
 * site's one hard rule (spec §2) is that anything with legal intent goes to
 * The Awad Law Firm, so that has to be stated where someone is about to type
 * a message, not only in the hero above.
 *
 * Posts to /api/contact, which already existed. Plain HTML POST is the
 * baseline and works with no JS; the script below upgrades it to a fetch so a
 * submission resolves in place instead of costing a page load. Field names
 * match the endpoint's zod schema exactly — name, email, subject, message,
 * plus the `website` honeypot.
 *
 * Surface deliberately matches PageContact's (navy-1000 + the same quarter
 * guides): the hero above is seamless with whatever follows it, and a
 * different background here would put a visible band across the page.
 */
import { CONTACT, FIRM_LINK_ATTR, FIRM_URL, OFFICE_HOURS } from '../../lib/site';

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';

// Sharp corners, mono type, hairline borders — same vocabulary as every other
// surface on the site. `color-scheme: dark` makes the native select dropdown
// render dark rather than as a white system panel over the navy.
const fieldClass =
  'w-full rounded-none border border-white/20 bg-white/[0.03] px-4 py-3 font-mono text-sm text-paper transition-colors placeholder:text-paper/35 focus:border-(--accent-muted) focus:outline-none';
const labelClass =
  'mb-2 block font-mono text-[0.6875rem] font-normal tracking-[0.2em] text-paper/55 uppercase';

/** Routed to the firm, so no legal option here on purpose. */
const SUBJECTS = [
  'Speaking or event booking',
  'Press or media',
  'General question',
  'Something else',
];
---

<section
  id="contact-form"
  class="on-dark relative scroll-mt-24 bg-navy-1000 text-paper"
  aria-labelledby="contact-form-heading"
>
  {/* Column guides continue from the hero above. */}
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <span class="absolute inset-y-0 left-1/4 w-px bg-white/12"></span>
    <span class="absolute inset-y-0 left-1/2 w-px bg-white/12"></span>
    <span class="absolute inset-y-0 left-3/4 w-px bg-white/12"></span>
  </div>

  <div
    class="relative mx-auto grid max-w-[110rem] grid-cols-1 gap-x-10 gap-y-16 px-(--spacing-gutter) pt-16 pb-28 sm:px-[calc(var(--spacing-gutter)+2rem)] lg:grid-cols-2 lg:pt-24 lg:pb-40"
  >
    {/* ---- Left: where things actually go ---------------------------- */}
    <div data-reveal>
      <p
        class="font-mono text-[0.6875rem] font-normal tracking-[0.25em] text-(--accent-muted) uppercase sm:text-xs"
      >
        [Send a message]
      </p>

      <h2
        id="contact-form-heading"
        class="mt-6 max-w-[14ch] font-display text-[clamp(2rem,4.4vw,3.75rem)] leading-[1.02] font-normal tracking-[-0.02em] uppercase"
      >
        Straight to the inbox
      </h2>

      <p class="mt-6 max-w-md font-mono text-sm leading-relaxed text-navy-100">
        Speaking, media, and everything else lands here and is read by a
        person. Include the date and the room if it is an event — it saves a
        round of email.
      </p>

      {/* The routing rule, stated at the point of writing rather than only in
          the hero. Bordered rather than coloured: the site has one accent and
          it belongs on the submit button, not on a notice. */}
      <div class="mt-10 border-l border-(--accent-muted) pl-5">
        <p class="font-mono text-sm leading-relaxed text-navy-100">
          Injury, malpractice, and wrongful death cases are handled through The
          Awad Law Firm, where intake lives and consultations cost nothing.
          Please do not send case details here.
        </p>
        <a
          href={FIRM_URL}
          {...FIRM_LINK_ATTR}
          class="mt-4 inline-block font-mono text-xs font-normal tracking-[0.08em] text-paper underline decoration-1 underline-offset-4 transition-opacity hover:opacity-60"
        >
          Go to the firm
        </a>
      </div>

      <div class="mt-10 space-y-2 font-mono text-sm">
        <a
          href={CONTACT.email.href}
          class="block w-fit underline underline-offset-4 transition-colors hover:text-(--accent-muted)"
        >
          {CONTACT.email.label}
        </a>
        <a
          href={CONTACT.booking.href}
          class="block w-fit underline underline-offset-4 transition-colors hover:text-(--accent-muted)"
        >
          {CONTACT.booking.label}
        </a>
      </div>

      {/* Kept from the old columns: the FAQ below still refers to office
          hours, so removing them entirely would leave that answer dangling. */}
      <div class="mt-10">
        <p
          class="font-mono text-[0.6875rem] font-normal tracking-[0.2em] text-paper/55 uppercase"
        >
          Office hours
        </p>
        <dl
          class="mt-4 grid max-w-xs grid-cols-[7.5rem_1fr] gap-y-2 font-mono text-sm text-navy-100"
        >
          {
            OFFICE_HOURS.map((row) => (
              <>
                <dt>{row.day}</dt>
                <dd>{row.hours}</dd>
              </>
            ))
          }
        </dl>
      </div>
    </div>

    {/* ---- Right: the form ------------------------------------------- */}
    <div data-reveal data-reveal-delay="0.08">
      {/* Status region. Populated by the script — either from ?sent=/?error=
          after a no-JS round trip, or directly from the fetch response. */}
      <div
        id="contact-status"
        role="status"
        aria-live="polite"
        hidden
        tabindex="-1"
        class="mb-8 border border-white/20 p-5 font-mono text-sm leading-relaxed"
      >
      </div>

      <form
        id="contact-form-el"
        method="post"
        action="/api/contact"
        class="space-y-6"
      >
        {/* Honeypot — hidden from people, tempting to bots. The endpoint
            fakes success when it is filled, so a bot learns nothing. */}
        <div class="hidden" aria-hidden="true">
          <label>
            Website
            <input type="text" name="website" tabindex="-1" autocomplete="off" />
          </label>
        </div>

        <div class="grid gap-6 sm:grid-cols-2">
          <div>
            <label class={labelClass} for="contact-name">Name</label>
            <input
              id="contact-name"
              name="name"
              required
              minlength="2"
              maxlength="120"
              autocomplete="name"
              class={fieldClass}
            />
          </div>
          <div>
            <label class={labelClass} for="contact-email">Email</label>
            <input
              id="contact-email"
              name="email"
              type="email"
              required
              maxlength="254"
              autocomplete="email"
              class={fieldClass}
            />
          </div>
        </div>

        <div>
          <label class={labelClass} for="contact-subject">Subject</label>
          <select
            id="contact-subject"
            name="subject"
            class:list={[fieldClass, '[color-scheme:dark]']}
          >
            {SUBJECTS.map((s) => <option value={s}>{s}</option>)}
          </select>
        </div>

        <div>
          <label class={labelClass} for="contact-message">Message</label>
          <textarea
            id="contact-message"
            name="message"
            rows="7"
            required
            minlength="10"
            maxlength="5000"
            class:list={[fieldClass, 'resize-y']}
            placeholder="The date, the room, the audience — or just the question."
          ></textarea>
        </div>

        {
          turnstileSiteKey && (
            <div
              class="cf-turnstile"
              data-sitekey={turnstileSiteKey}
              data-theme="dark"
            />
          )
        }

        <div class="flex flex-wrap items-center gap-x-6 gap-y-4 pt-2">
          <button
            id="contact-submit"
            type="submit"
            class="inline-flex items-center justify-center rounded-none bg-(--accent) px-8 py-4 font-mono text-sm font-normal tracking-[0.1em] text-(--accent-ink) uppercase transition-colors hover:bg-(--accent-strong) disabled:cursor-not-allowed disabled:opacity-60"
          >
            Send message
          </button>
          <p class="font-mono text-[0.6875rem] tracking-[0.05em] text-paper/45 uppercase">
            General information only — not legal advice
          </p>
        </div>
      </form>
    </div>
  </div>
</section>

{
  turnstileSiteKey && (
    <script
      is:inline
      src="https://challenges.cloudflare.com/turnstile/v0/api.js"
      async
      defer
    />
  )
}

<script>
  /**
   * Upgrades the plain POST to a fetch so a submission resolves in place.
   * Without JS the form still posts normally and the endpoint redirects back
   * with ?sent=1 or ?error=<code>, which the same banner below renders.
   */
  const form = document.getElementById('contact-form-el') as HTMLFormElement | null;
  const status = document.getElementById('contact-status');
  const submit = document.getElementById('contact-submit') as HTMLButtonElement | null;

  const ERRORS: Record<string, string> = {
    validation:
      'Some fields were missing or invalid — please check them and send again.',
    turnstile: 'The spam check could not verify your submission — please try again.',
    delivery:
      'Something went wrong sending your message. Please try again shortly, or email us directly using the address on the left.',
    'bad-request': 'The message could not be read — please try again.',
  };

  const SENT =
    'Thank you — your message is on its way. Expect a reply within office hours, usually the same day.';

  if (form && status && submit) {
    const show = (text: string, ok: boolean) => {
      status.textContent = text;
      // Accent border on success, plain hairline on failure — the site has no
      // red/green palette, so state is carried by the accent it already owns.
      status.classList.toggle('border-(--accent-muted)', ok);
      status.classList.toggle('text-paper', ok);
      status.classList.toggle('text-navy-100', !ok);
      status.hidden = false;
      status.focus();
    };

    // A no-JS submission comes back here as a query string.
    const params = new URLSearchParams(location.search);
    if (params.get('sent')) show(SENT, true);
    else {
      const code = params.get('error');
      if (code) show(ERRORS[code] ?? ERRORS['bad-request'], false);
    }

    form.addEventListener('submit', async (event) => {
      // Let the browser's own validation run first; if it fails, fall through
      // to the native messages rather than posting.
      if (!form.checkValidity()) return;

      event.preventDefault();
      submit.disabled = true;
      const label = submit.textContent;
      submit.textContent = 'Sending…';

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { accept: 'application/json' },
        });
        const data = (await res.json().catch(() => null)) as
          | { ok: boolean; code?: string }
          | null;

        if (res.ok && data?.ok) {
          form.reset();
          // Turnstile issues one token per solve, so a second send from the
          // same page needs a fresh challenge.
          window.turnstile?.reset?.();
          show(SENT, true);
        } else {
          show(ERRORS[data?.code ?? ''] ?? ERRORS['bad-request'], false);
          window.turnstile?.reset?.();
        }
      } catch {
        // Offline or the request never landed — never leave the visitor
        // staring at a disabled button with no explanation.
        show(ERRORS['delivery'], false);
      } finally {
        submit.disabled = false;
        submit.textContent = label;
      }
    });
  }
</script>
