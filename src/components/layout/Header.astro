---
import { Image } from 'astro:assets';
import karateLogo from '../../assets/karate-logo.png';
import { FIRM_URL, HEADER_NAV, SITE } from '../../lib/site';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

// Reference-matched CTA pair: sharp-cornered (rounded-none) buttons, one
// outlined + one solid royal-blue, uppercase with wide tracking. Shared base;
// the outline vs. fill treatment is applied per-button below.
const ctaClass =
  'inline-flex items-center gap-2 rounded-none px-4 py-2.5 font-mono text-xs font-normal uppercase tracking-[0.1em] whitespace-nowrap transition-colors sm:px-6 sm:py-3 sm:text-sm';
---

<header class="site-header on-dark text-paper">
  <!-- Full-viewport span (xnrgy-style): gutter padding only, no max-width
       wrap — logo sits at the left edge; the nav links flow continuously
       into the CTA pair as one right-aligned band. -->
  <div class="flex items-center gap-4 px-(--spacing-gutter) py-6 sm:px-[calc(var(--spacing-gutter)+2rem)] sm:py-9 xl:px-[calc(var(--spacing-gutter)+3.5rem)]">
    <a href="/" class="ml-2 shrink-0 sm:ml-4" aria-label={`${SITE.name} — home`}>
      <Image
        src={karateLogo}
        alt={SITE.name}
        widths={[120, 200]}
        sizes="(max-width: 640px) 100px, 130px"
        class="h-9 w-auto sm:h-12"
        loading="eager"
      />
    </a>

    {/* Right-hand band: nav links + CTAs read as one continuous, evenly
        spaced group (ref layout). ml-auto pushes the whole band right. */}
    <div class="ml-auto flex items-center gap-5 xl:gap-7">
      <nav aria-label="Primary" class="hidden items-center gap-5 lg:flex xl:gap-7">
        {
          HEADER_NAV.map((item) => (
            <a
              href={item.href}
              aria-current={currentPath === item.href ? 'page' : undefined}
              class="font-mono text-sm font-normal tracking-[0.1em] uppercase whitespace-nowrap text-paper transition-colors hover:text-(--accent-muted) aria-[current=page]:text-(--accent-muted)"
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <div class="flex items-center gap-2 sm:gap-3">
      {/* Outlined CTA (ref: "BOOK PADEL LESSONS") — thin light border, no
          fill. TODO: relink to the speaker funnel once pages return. */}
      <a
        href="#"
        class:list={[
          ctaClass,
          'border border-paper/60 text-paper hover:border-paper hover:bg-paper hover:text-navy-950',
        ]}
      >
        <svg
          class="hidden h-[18px] w-[18px] shrink-0 sm:block"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="3" y="4" width="18" height="17" rx="2.5"></rect>
          <path d="M16 2.5v3.5M8 2.5v3.5M3 9.5h18"></path>
          <path d="M8 13.5h.01M12 13.5h.01M16 13.5h.01M8 17h.01M12 17h.01M16 17h.01"></path>
        </svg>
        <span class="hidden sm:inline">Book Ibrahim to Speak</span>
        <span class="sm:hidden">Book to Speak</span>
      </a>
      {/* Solid CTA (ref: "BOOK A COURT") — the firm conversion. Uses the
          site --accent (deep indigo #192b88), consistent with the rest of
          the site. */}
      <a
        href={FIRM_URL}
        data-firm-link
        class:list={[
          ctaClass,
          'bg-(--accent) text-(--accent-ink) hover:bg-(--accent-strong)',
        ]}
      >
        <svg
          class="hidden h-[18px] w-[18px] shrink-0 sm:block"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <circle cx="12" cy="3.4" r="1.7"></circle>
          <rect x="4" y="4.6" width="16" height="1.7" rx="0.85"></rect>
          <rect x="11.15" y="4.6" width="1.7" height="14.4" rx="0.85"></rect>
          <path d="M5 5.8 1.3 12a3.7 3.7 0 0 0 7.4 0L5 5.8Z"></path>
          <path d="M19 5.8 15.3 12a3.7 3.7 0 0 0 7.4 0L19 5.8Z"></path>
          <rect x="7.5" y="19" width="9" height="2" rx="1"></rect>
        </svg>
        Need Legal Help?
      </a>
      </div>
    </div>
  </div>
</header>

<script>
  // Transparent-over-hero header: gain a solid background once scrolled.
  // Without JS, a <noscript> style in BaseLayout keeps it solid always.
  const header = document.querySelector('.site-header');
  const syncHeader = () =>
    header?.classList.toggle('is-solid', window.scrollY > 16);
  syncHeader();
  window.addEventListener('scroll', syncHeader, { passive: true });
</script>
