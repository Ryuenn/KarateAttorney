---
import { FIRM_URL, HEADER_NAV, NAV, SITE } from '../../lib/site';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

const ctaClass =
  'inline-flex items-center gap-2 rounded-md px-3.5 py-2.5 text-[0.6875rem] font-bold uppercase tracking-[0.15em] whitespace-nowrap transition-colors sm:px-5 sm:py-3 sm:text-sm';
---

<header class="site-header on-dark text-paper">
  <!-- Full-viewport span (xnrgy-style): gutter padding only, no max-width
       wrap — logo sits at the left edge, CTAs at the right edge. -->
  <div class="flex items-center justify-between gap-4 px-(--spacing-gutter) py-3 sm:py-4">
    <a
      href="/"
      class="font-display text-[0.8125rem] font-black tracking-[0.28em] uppercase whitespace-nowrap sm:text-lg"
      aria-label={`${SITE.name} — home`}
    >
      The <span class="text-gold-400">Karate</span> Attorney
    </a>

    <nav aria-label="Primary" class="hidden items-center gap-8 lg:flex">
      {
        HEADER_NAV.map((item) => (
          <a
            href={item.href}
            aria-current={currentPath === item.href ? 'page' : undefined}
            class="text-sm font-semibold tracking-[0.18em] uppercase whitespace-nowrap text-navy-100 transition-colors hover:text-gold-300 aria-[current=page]:text-gold-400"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2 sm:gap-3">
      {/* TODO: relink to the speaker funnel once pages return */}
      <a
        href="#"
        class:list={[ctaClass, 'bg-gold-400 text-navy-950 hover:bg-gold-300']}
      >
        <svg
          class="h-[18px] w-[18px] shrink-0"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="3" y="4" width="18" height="17" rx="2.5"></rect>
          <path d="M16 2.5v3.5M8 2.5v3.5M3 9.5h18"></path>
          <path d="M8 13.5h.01M12 13.5h.01M16 13.5h.01M8 17h.01M12 17h.01M16 17h.01"></path>
        </svg>
        <span class="hidden sm:inline">Book Ibrahim to Speak</span>
        <span class="sm:hidden">Book to Speak</span>
      </a>
      <a
        href={FIRM_URL}
        data-firm-link
        class:list={[
          ctaClass,
          'border border-paper/70 hover:bg-paper hover:text-navy-950',
        ]}
      >
        <svg
          class="h-[18px] w-[18px] shrink-0 text-gold-400"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <circle cx="12" cy="3.4" r="1.7"></circle>
          <rect x="4" y="4.6" width="16" height="1.7" rx="0.85"></rect>
          <rect x="11.15" y="4.6" width="1.7" height="14.4" rx="0.85"></rect>
          <path d="M5 5.8 1.3 12a3.7 3.7 0 0 0 7.4 0L5 5.8Z"></path>
          <path d="M19 5.8 15.3 12a3.7 3.7 0 0 0 7.4 0L19 5.8Z"></path>
          <rect x="7.5" y="19" width="9" height="2" rx="1"></rect>
        </svg>
        Need Legal Help?
      </a>

      <details id="site-menu" class="group relative">
        <summary
          class="flex h-10 w-10 cursor-pointer list-none items-center justify-center border border-navy-100/40 transition-colors hover:border-gold-300 sm:h-12 sm:w-12 [&::-webkit-details-marker]:hidden"
          aria-label="Open menu"
        >
          <span aria-hidden="true" class="relative block h-[10px] w-4">
            <span class="absolute top-0 left-0 h-0.5 w-full bg-current transition-transform group-open:translate-y-[4px] group-open:rotate-45"></span>
            <span class="absolute bottom-0 left-0 h-0.5 w-full bg-current transition-transform group-open:-translate-y-[4px] group-open:-rotate-45"></span>
          </span>
        </summary>
        <div class="absolute top-[calc(100%+0.75rem)] right-0 z-50 w-[min(20rem,calc(100vw-2*var(--spacing-gutter)))] rounded-2xl border border-navy-700 bg-navy-900 p-6 shadow-2xl">
          <nav aria-label="All pages">
            <ul class="space-y-1">
              {
                NAV.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      aria-current={currentPath === item.href ? 'page' : undefined}
                      class="block rounded-lg px-3 py-2 font-display text-lg font-bold transition-colors hover:bg-navy-800 hover:text-gold-300 aria-[current=page]:text-gold-400"
                    >
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
          <div class="mt-4 border-t border-navy-700 pt-4">
            <a
              href={FIRM_URL}
              data-firm-link
              class="block rounded-lg px-3 py-2 text-sm font-semibold text-gold-300 hover:bg-navy-800"
            >
              Injured? The Awad Law Firm →
              <span lang="es" class="mt-0.5 block text-xs font-normal text-navy-200">
                ¿Lesionado? Visite The Awad Law Firm
              </span>
            </a>
          </div>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  // Transparent-over-hero header: gain a solid background once scrolled.
  // Without JS, a <noscript> style in BaseLayout keeps it solid always.
  const header = document.querySelector('.site-header');
  const syncHeader = () =>
    header?.classList.toggle('is-solid', window.scrollY > 16);
  syncHeader();
  window.addEventListener('scroll', syncHeader, { passive: true });

  // Progressive enhancement for the <details> menu: close on Escape,
  // outside click, or link click. Without JS the menu still opens/closes.
  const menu = document.getElementById('site-menu') as HTMLDetailsElement | null;
  if (menu) {
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
    document.addEventListener('click', (e) => {
      if (menu.open && e.target instanceof Node && !menu.contains(e.target)) {
        menu.open = false;
      }
    });
    menu.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', () => (menu.open = false)),
    );
  }
</script>
