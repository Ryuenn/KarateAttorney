---
import { FIRM_URL } from '../../lib/site';
---

<div class="bg-gold-400 text-navy-950">
  <div class="wrap flex flex-wrap items-center justify-center gap-x-2 py-1.5 text-center text-[0.8125rem] font-semibold sm:text-sm">
    <a
      href={FIRM_URL}
      data-firm-link
      class="underline decoration-navy-950/40 underline-offset-2 hover:decoration-navy-950"
    >
      Looking to hire Ibrahim for your injury case? Go to The Awad Law Firm →
    </a>
    <span aria-hidden="true" class="hidden sm:inline">·</span>
    <a
      href={FIRM_URL}
      data-firm-link
      lang="es"
      class="hidden underline decoration-navy-950/40 underline-offset-2 hover:decoration-navy-950 sm:inline"
    >
      ¿Lesionado? Visite The Awad Law Firm
    </a>
  </div>
</div>
