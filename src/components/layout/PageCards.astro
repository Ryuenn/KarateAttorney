---
/**
 * Three-up card row that closes an inner page (xnrgy reference).
 *
 * Each card is a landscape photo, an uppercase display title, a mono
 * paragraph and an underlined "Discover more" link. Cards sit on the same
 * paper band as the marquee above them, so the two read as one light
 * section.
 *
 * Link rows ARE bottom-aligned across the three cards: each card is a
 * flex column stretched to the row height, and the link takes mt-auto so it
 * sits on a common baseline no matter how many lines the body runs to. The
 * pt keeps a minimum gap above it when a card's copy is long.
 *
 * Photos are PLACEHOLDERS until real photography is supplied; pass `image`
 * (a path under public/) on a card to drop the real one in.
 */
import { FIRM_LINK_ATTR } from '../../lib/site';

interface Card {
  title: string;
  body: string;
  href: string;
  /** Link text. Defaults to the reference's "Discover more". */
  linkLabel?: string;
  /** Path under public/. Omit for the placeholder. */
  image?: string;
  imageAlt?: string;
  /**
   * Focal point as Tailwind object-position classes, for photos whose ratio
   * differs from the 16/9 frame. Defaults to centre.
   */
  imagePosition?: string;
  /** Marks an outbound link to the firm site for the analytics layer. */
  firm?: boolean;
}

interface Props {
  cards: Card[];
}

const { cards } = Astro.props;
---

<section class="relative bg-paper text-ink">
  {/* Column guides continue from the band above. */}
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <span class="absolute inset-y-0 left-1/4 w-px bg-ink/10"></span>
    <span class="absolute inset-y-0 left-1/2 w-px bg-ink/10"></span>
    <span class="absolute inset-y-0 left-3/4 w-px bg-ink/10"></span>
  </div>

  <div
    class="relative mx-auto grid max-w-[76rem] grid-cols-1 gap-x-10 gap-y-16 px-(--spacing-gutter) pt-16 pb-28 sm:px-[calc(var(--spacing-gutter)+2rem)] lg:grid-cols-3 lg:px-8 lg:pt-28 lg:pb-40"
  >
    {
      cards.map((card) => (
        <article class="flex flex-col" data-reveal>
          {/* 16/9 matches the supplied photography exactly, so object-cover
              has nothing to crop. A 4/3 frame cut ~25% off the sides, which
              on a group shot meant losing the people at both edges. */}
          <div class="aspect-video w-full overflow-hidden">
            {card.image ? (
              <img
                src={card.image}
                alt={card.imageAlt ?? ''}
                class:list={[
                  'h-full w-full object-cover',
                  card.imagePosition ?? 'object-center',
                ]}
                loading="lazy"
                decoding="async"
              />
            ) : (
              /* Stand-in until real photography lands — sharp-cornered and
                 dashed so it reads as an intentional empty slot. */
              <div
                class="grid h-full w-full place-items-center border border-dashed border-ink/30 bg-ink/[0.04]"
                aria-hidden="true"
              >
                <p class="px-4 text-center font-mono text-[0.6875rem] tracking-[0.2em] text-ink/40 uppercase">
                  [Placeholder image]
                </p>
              </div>
            )}
          </div>

          <h3 class="mt-8 font-display text-[clamp(1.375rem,2.1vw,1.875rem)] leading-tight font-normal tracking-[-0.01em] uppercase">
            {card.title}
          </h3>

          <p class="mt-5 font-mono text-sm leading-relaxed font-normal text-ink">
            {card.body}
          </p>

          <a
            href={card.href}
            class="mt-auto self-start pt-8 font-mono text-xs font-normal tracking-[0.08em] text-ink underline decoration-1 underline-offset-4 transition-opacity hover:opacity-60"
            {...(card.firm ? FIRM_LINK_ATTR : {})}
          >
            {card.linkLabel ?? 'Discover more'}
          </a>
        </article>
      ))
    }
  </div>
</section>
