---
import { Image } from 'astro:assets';
import karateLogo from '../../assets/karate-logo.png';
import { CONTACT, FIRM_URL, NAV, SITE, SOCIALS } from '../../lib/site';

const year = new Date().getFullYear();

// Big nav links, split into two columns (xnrgy reference). Falls back to the
// full NAV; if NAV is empty the columns simply don't render.
const half = Math.ceil(NAV.length / 2);
const navCols = [NAV.slice(0, half), NAV.slice(half)];

// Contact details live in lib/site.ts (still [PLACEHOLDER] values) so this
// footer and /contact always show the same phone and inbox.

// Minimal inline social glyphs so the icon row needs no external assets.
const socialIcon: Record<string, string> = {
  Instagram:
    'M12 2.2c3.2 0 3.6 0 4.8.07 1.2.05 1.8.25 2.2.42.6.22 1 .5 1.4.94.44.43.72.83.94 1.42.17.4.37 1 .42 2.2.06 1.2.07 1.6.07 4.75s0 3.55-.07 4.75c-.05 1.2-.25 1.8-.42 2.2a3.9 3.9 0 0 1-.94 1.42c-.43.44-.83.72-1.42.94-.4.17-1 .37-2.2.42-1.2.06-1.6.07-4.75.07s-3.55 0-4.75-.07c-1.2-.05-1.8-.25-2.2-.42a3.9 3.9 0 0 1-1.42-.94 3.9 3.9 0 0 1-.94-1.42c-.17-.4-.37-1-.42-2.2C2.2 15.55 2.2 15.15 2.2 12s0-3.55.07-4.75c.05-1.2.25-1.8.42-2.2.22-.6.5-1 .94-1.42.43-.44.83-.72 1.42-.94.4-.17 1-.37 2.2-.42C8.45 2.2 8.85 2.2 12 2.2Zm0 3.05a6.75 6.75 0 1 0 0 13.5 6.75 6.75 0 0 0 0-13.5Zm0 11.13a4.38 4.38 0 1 1 0-8.76 4.38 4.38 0 0 1 0 8.76Zm6.9-11.4a1.58 1.58 0 1 1-3.15 0 1.58 1.58 0 0 1 3.15 0Z',
  YouTube:
    'M23.5 6.5a3 3 0 0 0-2.1-2.1C19.5 3.9 12 3.9 12 3.9s-7.5 0-9.4.5A3 3 0 0 0 .5 6.5C0 8.4 0 12 0 12s0 3.6.5 5.5a3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1C24 15.6 24 12 24 12s0-3.6-.5-5.5ZM9.6 15.6V8.4l6.3 3.6-6.3 3.6Z',
  TikTok:
    'M16.5 3c.4 2.3 1.7 3.9 3.9 4.1v2.6c-1.3.1-2.5-.3-3.9-1.1v5.6c0 4.7-3.5 6.6-6.4 6.6-2.7 0-4.9-2-4.9-4.9 0-3 2.4-5 5.4-4.7v2.7c-.5-.1-1-.2-1.4-.1-1 .2-1.7 1-1.7 2 0 1.2 1 2.1 2.2 2 1.3 0 2.2-1 2.2-2.5V3h2.6Z',
  LinkedIn:
    'M6.94 5a2 2 0 1 1-4 0 2 2 0 0 1 4 0ZM3.3 8.5h3.3V21H3.3V8.5Zm5.4 0h3.16v1.7h.05c.44-.83 1.5-1.7 3.1-1.7 3.3 0 3.9 2.17 3.9 5V21h-3.3v-4.9c0-1.17 0-2.68-1.63-2.68-1.64 0-1.9 1.28-1.9 2.6V21H8.7V8.5Z',
};
---

<footer class="on-dark bg-navy-950 text-navy-100">
  {/* Asymmetric vertical padding: generous above so the columns breathe,
      tight below so the bottom bar sits near the page end instead of
      leaving a dead band under the copyright line. */}
  <div
    class="mx-auto w-full max-w-[110rem] px-4 pt-20 pb-10 sm:px-6 lg:px-8 lg:pt-28 lg:pb-12"
  >
    <div class="grid gap-16 lg:grid-cols-[1.4fr_1fr_1fr] lg:gap-12">
      {/* Left: logo, intro line, contact links */}
      <div>
        <Image
          src={karateLogo}
          alt={SITE.name}
          widths={[160, 220]}
          sizes="180px"
          class="h-12 w-auto"
          loading="lazy"
        />
        <p class="mt-8 max-w-xs font-mono text-sm leading-relaxed text-navy-100">
          Questions, a case, or a stage to fill? Reach out — the courtroom, the
          mat, and the podium all start with a conversation.
        </p>
        <div class="mt-10 space-y-2 font-mono text-sm">
          <a
            href={CONTACT.phone.href}
            class="block w-fit underline underline-offset-4 transition-colors hover:text-(--accent-muted)"
          >
            {CONTACT.phone.label}
          </a>
          <a
            href={CONTACT.email.href}
            class="block w-fit underline underline-offset-4 transition-colors hover:text-(--accent-muted)"
          >
            {CONTACT.email.label}
          </a>
        </div>
      </div>

      {/* Middle column: first half of the big nav links */}
      {
        navCols[0].length > 0 && (
          <nav aria-label="Footer">
            <ul class="space-y-4">
              {navCols[0].map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="font-display text-[clamp(1.75rem,3vw,2.5rem)] leading-none font-normal tracking-tight text-paper uppercase transition-colors hover:text-(--accent-muted)"
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }

      {/* Right column: second half of the nav links, then the firm CTA,
          "Stay connected" and social icons stacked below (reference layout). */}
      <div>
        {navCols[1].length > 0 && (
          <nav aria-label="Footer">
            <ul class="space-y-4">
              {navCols[1].map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="font-display text-[clamp(1.75rem,3vw,2.5rem)] leading-none font-normal tracking-tight text-paper uppercase transition-colors hover:text-(--accent-muted)"
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )}

          <a
            href={FIRM_URL}
            data-firm-link
            {/* max-w-xs keeps this narrow in the stacked mobile layout, but
                is released once the 3-column grid kicks in — otherwise the
                rule stops ~60px short of the column edge while the bottom
                bar runs flush right, reading as a lopsided right margin. */}
            class="group mt-12 flex max-w-xs items-center justify-between border-b border-white/20 pb-4 font-display text-lg tracking-tight text-paper transition-colors hover:border-(--accent-muted) lg:max-w-none"
          >
            <span>Need Legal Help?</span>
            <svg
              class="h-5 w-5 shrink-0 text-navy-100 transition-[transform,color] duration-300 ease-(--ease-smooth) group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-(--accent-muted)"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M7 17 17 7M9 7h8v8" />
            </svg>
          </a>

          <p class="mt-12 font-mono text-xs tracking-[0.15em] text-navy-300 uppercase">
            Stay connected
          </p>
          <ul class="mt-4 flex items-center gap-4">
            {
              SOCIALS.map((s) => (
                <li>
                  <a
                    href={s.href}
                    rel="noopener"
                    aria-label={s.label}
                    class="flex h-9 w-9 items-center justify-center border border-white/15 text-navy-100 transition-colors hover:border-(--accent-muted) hover:text-(--accent-muted)"
                  >
                    <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d={socialIcon[s.label] ?? ''} />
                    </svg>
                  </a>
                </li>
              ))
            }
          </ul>
      </div>
    </div>

    {/* Bottom bar. data-footer-bar is the reference the homepage's floating
        CTA measures against so it can lift clear of this line instead of
        sitting on top of it (see FloatingCta.astro). */}
    <div
      data-footer-bar
      class="mt-20 flex flex-col gap-2 border-t border-white/10 pt-8 font-mono text-xs text-navy-300 sm:flex-row sm:items-center sm:justify-between lg:mt-28"
    >
      <p>© {year} {SITE.person} · {SITE.name}. All rights reserved.</p>
      <p>
        {/* Explicit space: Astro strips the newline between the text and
            the link, so without it the words run together. */}
        Legal representation is provided through{' '}
        <a
          href={FIRM_URL}
          data-firm-link
          class="text-(--accent-muted) underline-offset-2 hover:underline"
        >
          The Awad Law Firm</a
        >.
      </p>
    </div>
  </div>
</footer>
