---
/**
 * FAQ block (xnrgy reference).
 *
 * Display headline, a one-line prompt, a solid accent CTA, then a rule-
 * separated accordion.
 *
 * Sized off the reference, where this block is one of the largest things on
 * the page: the column runs the middle half of the viewport (roughly the 25%
 * and 75% guides, hence 57rem) and the questions are set noticeably above
 * body size — they are the thing being scanned, not supporting copy. It is
 * therefore WIDER than PageFeature's 38rem column; the two still share a
 * centre axis, but their text edges no longer line up.
 *
 * Built on native <details>/<summary>: it opens and closes with no
 * JavaScript at all, is keyboard operable for free, and is announced
 * correctly by screen readers. The +/− swap is pure CSS via the open state.
 */
interface FaqItem {
  q: string;
  a: string;
}

interface Props {
  items: FaqItem[];
  /** Headline. "\n" forces a line break; still wraps naturally. */
  heading?: string;
  prompt?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  items,
  heading = 'Frequently asked\nquestions, answered',
  prompt = "Don't see your question here? Get in touch.",
  ctaLabel = 'Contact Ibrahim',
  ctaHref = '#',
} = Astro.props;
---

<section class="relative bg-paper text-ink">
  {/* Column guides continue from the sections above. */}
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <span class="absolute inset-y-0 left-1/4 w-px bg-ink/10"></span>
    <span class="absolute inset-y-0 left-1/2 w-px bg-ink/10"></span>
    <span class="absolute inset-y-0 left-3/4 w-px bg-ink/10"></span>
  </div>

  <div
    class="relative mx-auto w-full max-w-[57rem] px-(--spacing-gutter) py-28 sm:px-0 lg:py-40"
  >
    <h2
      class="font-display text-[clamp(2rem,4.6vw,4rem)] leading-[1.05] font-normal tracking-[-0.02em] whitespace-pre-line uppercase"
      data-reveal
    >
      {heading}
    </h2>

    <p
      class="mt-10 font-mono text-base leading-relaxed font-normal text-ink sm:text-lg"
      data-reveal
    >
      {prompt}
    </p>

    <div data-reveal>
      <a
        href={ctaHref}
        class="mt-8 inline-flex items-center gap-2.5 rounded-none bg-(--accent) px-6 py-4 font-mono text-xs font-normal tracking-[0.1em] text-(--accent-ink) uppercase transition-colors hover:bg-(--accent-strong) sm:text-[0.8125rem]"
      >
        <svg
          class="h-[1.125rem] w-[1.125rem] shrink-0"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M4 3h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H9l-5 4V5a2 2 0 0 1 2-2Z"
          ></path>
        </svg>
        {ctaLabel}
      </a>
    </div>

    <div class="mt-16 border-t border-ink/20 lg:mt-20" data-reveal>
      {
        items.map((item) => (
          <details class="group border-b border-ink/20">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-8 py-6 font-mono text-base font-normal sm:py-7 sm:text-lg [&::-webkit-details-marker]:hidden">
              <span>{item.q}</span>
              {/* +/− swap driven by the open state — no script. */}
              <span
                class="shrink-0 text-xl leading-none select-none sm:text-2xl"
                aria-hidden="true"
              >
                <span class="group-open:hidden">+</span>
                <span class="hidden group-open:inline">−</span>
              </span>
            </summary>
            <p class="max-w-[68ch] pb-7 font-mono text-sm leading-relaxed font-normal text-ink/75 sm:text-base">
              {item.a}
            </p>
          </details>
        ))
      }
    </div>
  </div>
</section>
