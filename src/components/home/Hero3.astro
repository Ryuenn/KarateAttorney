---
/**
 * Homepage 3 — classic law-firm layout (GTLAW-style reference).
 * Self-contained: its own two-tier navbar + hero + practice cards. Uses the
 * provided homepage-3 hero photo of Ibrahim. Navy + gold colorway.
 */
import { Image } from 'astro:assets';
import heroPhoto from '../../assets/homepage-3-hero.png';
import { FIRM_URL } from '../../lib/site';

const navLinks = [
  { label: 'Home', href: '/homepage-3' },
  { label: 'About Us', href: '#' },
  { label: 'Speaking', href: '#' },
  { label: 'Contact Us', href: '#' },
];

const cards = [
  {
    title: 'Trial Law',
    sub: 'Courtroom advocacy that fights for injured people.',
    icon: 'gavel',
    highlight: false,
  },
  {
    title: 'Martial Arts',
    sub: 'Discipline, focus, and respect — on and off the mat.',
    icon: 'scales',
    highlight: false,
  },
  {
    title: 'Speaking',
    sub: 'Keynotes, khutbahs, and talks that move audiences.',
    icon: 'mic',
    highlight: true,
  },
];
---

<div class="overflow-x-clip bg-navy-900 text-paper">
  <!-- ============ Two-tier navbar ============ -->
  <header class="on-dark">
    <!-- Top tier: logo + cart + consultation CTA -->
    <div class="wrap flex items-center justify-between gap-3 py-4 sm:py-5">
      <a href="/homepage-3" class="flex items-center gap-2 sm:gap-3" aria-label="The Karate Attorney — home">
        <svg class="h-7 w-7 shrink-0 text-gold-400 sm:h-9 sm:w-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 8h16M6 8v10M18 8v10M4 18h16M9 8v10M15 8v10M12 3 5 8h14z" />
        </svg>
        <span class="font-display text-base font-black tracking-[0.12em] whitespace-nowrap sm:text-2xl sm:tracking-[0.15em]">
          KARATE<span class="text-gold-400">ATTORNEY</span>
        </span>
      </a>

      <div class="flex items-center gap-4 sm:gap-6">
        <a href="#" class="hidden items-center gap-2 text-sm text-navy-100 hover:text-gold-300 md:flex">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4zM3 6h18M16 10a4 4 0 0 1-8 0" />
          </svg>
          Cart (0)
        </a>
        <a
          href="#"
          class="rounded-sm bg-gold-400 px-4 py-2.5 text-xs font-semibold whitespace-nowrap text-navy-950 transition-colors hover:bg-gold-300 sm:px-6 sm:py-3 sm:text-sm"
        >
          <span class="hidden sm:inline">Book a Consultation</span>
          <span class="sm:hidden">Book Now</span>
        </a>
      </div>
    </div>

    <div class="border-t border-white/10"></div>

    <!-- Bottom tier: nav links + contact info -->
    <div class="wrap flex flex-col gap-3 py-4 lg:flex-row lg:items-center lg:justify-between">
      <nav aria-label="Primary" class="flex flex-wrap items-center gap-7">
        {
          navLinks.map((item) => (
            <a
              href={item.href}
              class="text-sm font-medium text-paper transition-colors hover:text-gold-300"
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <div class="flex flex-wrap items-center gap-6">
        <a href="tel:+10000000000" class="flex items-center gap-3">
          <span class="grid h-10 w-10 place-items-center rounded-full border border-white/20 text-gold-400">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M6.6 10.8a15 15 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24 11 11 0 0 0 3.4.55 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.3a1 1 0 0 1 1 1 11 11 0 0 0 .55 3.4 1 1 0 0 1-.25 1z" />
            </svg>
          </span>
          <span class="text-sm">
            <span class="block text-navy-200">Call Us On:</span>
            <span class="block font-semibold">[PLACEHOLDER: phone]</span>
          </span>
        </a>
        <a href="mailto:hello@example.com" class="flex items-center gap-3">
          <span class="grid h-10 w-10 place-items-center rounded-full border border-white/20 text-gold-400">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <rect x="3" y="5" width="18" height="14" rx="2" />
              <path d="m3 7 9 6 9-6" />
            </svg>
          </span>
          <span class="text-sm">
            <span class="block text-navy-200">Email Us:</span>
            <span class="block font-semibold">[PLACEHOLDER: email]</span>
          </span>
        </a>
      </div>
    </div>
  </header>

  <!-- ============ Hero ============ -->
  <section class="relative">
    <!-- Hero band: bounded so the photo stays inside it and the cards below
         can overlap its bottom edge (reference layout). -->
    <div class="relative isolate overflow-hidden">
      <div class="absolute inset-0 -z-10" aria-hidden="true">
        <div class="absolute inset-0 bg-navy-900"></div>
        <Image
          src={heroPhoto}
          alt="Ibrahim Awad — The Karate Attorney"
          widths={[900, 1400, 1774]}
          sizes="(max-width: 1024px) 100vw, 60vw"
          class="absolute inset-y-0 right-0 h-full w-full object-cover object-right lg:w-[62%]"
          loading="eager"
        />
        <!-- Left fade so the copy stays readable over the photo -->
        <div class="absolute inset-0 bg-gradient-to-r from-navy-900 via-navy-900/85 to-transparent lg:via-navy-900/40"></div>
      </div>

      <div class="wrap pt-14 pb-40 sm:pt-16 lg:pb-48">
        <div class="max-w-xl">
          <!-- gold decorative mark -->
          <div class="flex items-center gap-2" data-reveal>
            <span class="h-px w-10 bg-gold-400"></span>
            <span class="text-gold-400">✦</span>
            <span class="h-px w-4 bg-gold-400"></span>
          </div>

          <h1
            class="mt-6 font-serif text-[clamp(2.5rem,5vw,4rem)] leading-[1.1] text-gold-300"
            data-reveal
          >
            Deeper Understanding<br />Better Solutions
          </h1>

          <p class="mt-5 max-w-md leading-relaxed text-navy-100" data-reveal>
            [PLACEHOLDER: hero subheading — two lines about Ibrahim&rsquo;s
            approach as a trial lawyer, martial artist, and speaker.]
          </p>

          <a
            href="#"
            class="mt-8 inline-block rounded-sm bg-gold-400 px-9 py-4 text-sm font-semibold tracking-wide text-navy-950 transition-colors hover:bg-gold-300"
            data-reveal
          >
            Get In Touch
          </a>
        </div>
      </div>
    </div>

    <!-- ============ Practice-area cards ============ -->
    <!-- Pulled up to overlap the hero band's bottom edge. -->
    <div class="wrap relative z-10 -mt-28 pb-20 sm:-mt-32">
      <ul class="grid gap-5 sm:grid-cols-3">
        {
          cards.map((c) => (
            <li
              class:list={[
                'rounded-md p-7 shadow-xl transition-transform hover:-translate-y-1',
                c.highlight ? 'bg-gold-400 text-navy-950' : 'bg-white text-ink',
              ]}
              data-reveal
            >
              <span
                class:list={[
                  'inline-block',
                  c.highlight ? 'text-navy-900' : 'text-gold-500',
                ]}
                aria-hidden="true"
              >
                {c.icon === 'gavel' && (
                  <svg class="h-9 w-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m14 3 7 7-3 3-7-7zM11 6 4 13l3 3 7-7M3 21h8M6 18l-3 3" />
                  </svg>
                )}
                {c.icon === 'scales' && (
                  <svg class="h-9 w-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 3v18M7 21h10M5 7l-3 6a3 3 0 0 0 6 0L5 7zm14 0-3 6a3 3 0 0 0 6 0l-3-6zM5 7h14" />
                  </svg>
                )}
                {c.icon === 'mic' && (
                  <svg class="h-9 w-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="9" y="2" width="6" height="12" rx="3" />
                    <path d="M5 11a7 7 0 0 0 14 0M12 18v3M8 21h8" />
                  </svg>
                )}
              </span>
              <h3 class="mt-5 font-serif text-2xl">{c.title}</h3>
              <p
                class:list={[
                  'mt-3 text-sm leading-relaxed',
                  c.highlight ? 'text-navy-900/80' : 'text-ink/60',
                ]}
              >
                {c.sub}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</div>
