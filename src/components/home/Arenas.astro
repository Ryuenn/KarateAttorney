---
/**
 * Homepage 1 — "Three Arenas" sticky scroll-stepper (xnrgy clubs reference).
 *
 * A centred card on a plain (white) background steps through Ibrahim's three
 * arenas — the courtroom, the mat, the stage — as the section is pinned and
 * scrolled. Bracketed mono side labels flank the card.
 *
 * Progressive enhancement: the stepper (pin + swap) is wired by motion.ts,
 * which adds `.ka-arenas` to <html> only when JS + ScrollTrigger are present
 * and the viewport is wide enough. Without that class the cards render
 * stacked and fully readable — a failed script can never blank the section.
 */
const arenas = [
  {
    title: 'The Courtroom',
    img: '/ibrahim-4.png',
    alt: 'Ibrahim Awad presenting, mic in hand',
    body: 'Where preparation meets pressure. Whether addressing a jury or a room, Ibrahim commands it the same way — calm, prepared, and direct. Insurance companies bank on lawyers who would rather settle than try a case; he built his practice on the opposite instinct.',
  },
  {
    title: 'The Mat',
    img: '/kickin.JPG',
    alt: 'Ibrahim Awad training on the heavy bag',
    body: 'Where the discipline was forged. Long before any courtroom, it was the bag, the gloves, and the reps — drilling composure until it holds when everything is on the line. The same calm he now brings to a case and to a stage was earned here, one round at a time.',
  },
  {
    title: 'The Stage',
    img: '/stage.png',
    alt: 'Ibrahim Awad — TEDx Talk "On Beautiful Patience", TEDxOcala',
    body: 'Where the lessons are shared. In his TEDxOcala talk, "On Beautiful Patience," Ibrahim turns discipline and resilience into a message an audience can carry — the throughline of the mat and the courtroom, spoken aloud.',
  },
];

const total = String(arenas.length).padStart(2, '0');
---

<section class="ka-arenas-section relative text-ink" data-arenas>
  <div
    class="ka-arenas-stage relative bg-cover bg-center bg-no-repeat"
    style="background-image: url('/keep-scrolling.png');"
  >
    {/* Bracketed mono side labels (xnrgy reference) */}
    <span
      class="ka-arenas-aside pointer-events-none absolute top-1/2 left-[18%] hidden -translate-y-1/2 font-mono text-sm tracking-[0.05em] text-paper/80 lg:block xl:left-[24%]"
      aria-hidden="true"
    >
      [Three Arenas]
    </span>
    <span
      class="ka-arenas-aside pointer-events-none absolute top-1/2 right-[18%] hidden -translate-y-1/2 font-mono text-sm tracking-[0.05em] text-paper/80 lg:block xl:right-[24%]"
      aria-hidden="true"
    >
      [Keep scrolling]
    </span>

    {/* Fixed white window (mask). Once .ka-arenas is live this is a
        fixed-height box with overflow:hidden — the card track scrolls INSIDE
        it, so the next card is never visible outside the white frame (it
        slides up into view from within). In the no-JS fallback the mask has
        no fixed height and the cards simply stack and read normally. */}
    <div class="ka-arenas-window mx-auto w-full max-w-xl bg-white shadow-xl">
      <div class="ka-arenas-track" data-arena-track>
        {
          arenas.map((a, i) => (
            <article
              class="ka-arenas-card px-8 py-10 text-center sm:px-12 sm:py-12"
              data-arena-card
              data-reveal
            >
              <p class="font-mono text-sm tracking-[0.15em] text-ink/60">
                <span class="text-ink">{String(i + 1).padStart(2, '0')}</span>
                <span class="mx-2">—</span>
                <span>{total}</span>
              </p>

              <h3 class="mx-auto mt-4 max-w-[16ch] font-display text-[clamp(1.75rem,3.4vw,2.75rem)] leading-[1.05] font-normal tracking-tight uppercase">
                {a.title}
              </h3>

              <img
                src={a.img}
                alt={a.alt}
                class="mx-auto mt-7 max-h-[34vh] w-full object-cover"
                loading="lazy"
                decoding="async"
              />

              <p class="mx-auto mt-7 max-w-lg font-mono text-sm leading-relaxed text-ink/75">
                {a.body}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
