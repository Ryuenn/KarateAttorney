---
/**
 * Full-bleed video hero (spec §3 + §6 guardrails).
 *
 * - Poster paints first and is the LCP; video sources are attached by JS
 *   only when the connection/motion/device allows, so the video can never
 *   block first paint — and with JS disabled the poster simply stays.
 * - Expected assets (not yet provided — see README asset list):
 *     public/media/hero.mp4         compressed desktop loop
 *     public/media/hero-mobile.mp4  lighter mobile rendition
 *     public/media/hero-poster.jpg  poster frame (the LCP image)
 */
import { FIRM_URL, SITE } from '../../lib/site';
import Button from '../ui/Button.astro';
---

<!-- Full viewport: the fixed transparent header overlays this section, so
     100svh keeps the CTA row exactly at the fold (spec §3 non-negotiable). -->
<section class="on-dark relative isolate flex min-h-svh flex-col overflow-hidden bg-navy-950 text-paper">
  <div class="absolute inset-0 -z-20" aria-hidden="true">
    <video
      id="hero-video"
      class="h-full w-full object-cover opacity-70"
      muted
      autoplay
      loop
      playsinline
      preload="none"
      poster="/media/hero-poster.jpg"
      tabindex="-1"
    ></video>
    <div class="absolute inset-0 bg-gradient-to-t from-navy-950/90 via-navy-950/40 to-navy-950/35"></div>
  </div>

  <!-- Full-viewport span like the navbar — the wordmark scales with vw and
       must never be caged by the centered wrap, or it wraps on wide screens. -->
  <div class="relative flex flex-1 flex-col px-(--spacing-gutter) pt-20 pb-6 sm:pt-24 sm:pb-8">
    <p
      data-hero-line
      class="text-[0.6875rem] font-bold tracking-[0.25em] text-gold-300 uppercase sm:text-sm"
    >
      {SITE.person} — Trial lawyer · Martial artist · TEDx speaker · Khateeb
    </p>

    <!-- xnrgyclub-style oversized staggered wordmark over the video -->
    <!-- Both lines cluster at the bottom (justify-end) so the headline sits
         low, clear of the navbar, with open video above it. -->
    <h1
      class="mt-4 flex min-h-0 flex-1 flex-col justify-end gap-3 font-display font-black tracking-tight uppercase sm:gap-5"
    >
      <span
        data-hero-line
        class="block text-[clamp(3rem,12.5vw,12rem)] leading-[0.85] whitespace-nowrap"
      >
        The Karate
      </span>
      <span
        data-hero-line
        class="block self-end text-right text-[clamp(3rem,12.5vw,12rem)] leading-[0.85] whitespace-nowrap"
      >
        Attorney<span class="text-gold-400">.</span>
      </span>
    </h1>

    <div class="mt-6 flex flex-col gap-4 sm:mt-8 sm:flex-row sm:items-end sm:justify-between">
      <div data-hero-line class="flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        <Button href="/speaking#request" variant="light" size="lg">
          Book Ibrahim to Speak
        </Button>
        <Button href={FIRM_URL} variant="gold" size="lg" data-firm-link>
          Injured? Hire Ibrahim →
          <span class="sr-only">at The Awad Law Firm</span>
        </Button>
      </div>
      <p data-hero-line class="text-xs text-navy-200 sm:max-w-xs sm:text-right">
        Legal cases are handled at The Awad Law Firm ·
        <span lang="es">¿Lesionado? Visite The Awad Law Firm</span>
      </p>
    </div>
  </div>
</section>

<script>
  // Attach video sources only when appropriate (spec §6): never on
  // save-data / 2G, never under reduced motion. Small screens get the
  // lighter rendition. Missing files fail silently — the poster remains.
  const video = document.getElementById('hero-video') as HTMLVideoElement | null;

  if (video) {
    const nav = navigator as Navigator & {
      connection?: { saveData?: boolean; effectiveType?: string };
    };
    const conn = nav.connection;
    const slow = conn ? /(^|-)2g/.test(conn.effectiveType ?? '') : false;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!conn?.saveData && !slow && !reduced) {
      const small = matchMedia('(max-width: 767px)').matches;
      const source = document.createElement('source');
      source.src = small ? '/media/hero-mobile.mp4' : '/media/hero.mp4';
      source.type = 'video/mp4';
      source.addEventListener('error', () => video.removeAttribute('src'));
      video.append(source);
      video.load();
      video.play().catch(() => {
        /* autoplay refused — poster stays, which is fine */
      });
    }
  }
</script>
