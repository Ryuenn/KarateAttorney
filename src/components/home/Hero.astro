---
/**
 * Full-bleed video hero (spec §3 + §6 guardrails).
 *
 * - Poster paints first and is the LCP; video sources are attached by JS
 *   only when the connection/motion/device allows, so the video can never
 *   block first paint — and with JS disabled the poster simply stays.
 * - Expected assets (not yet provided — see README asset list):
 *     public/media/hero.mp4         compressed desktop loop
 *     public/media/hero-mobile.mp4  lighter mobile rendition
 *     public/media/hero-poster.jpg  poster frame (the LCP image)
 */
import { SITE } from '../../lib/site';
---

<!-- Full viewport: the fixed transparent header overlays this section, so
     100svh keeps the CTA row exactly at the fold (spec §3 non-negotiable). -->
<section class="on-dark relative isolate flex min-h-svh flex-col overflow-hidden bg-navy-950 text-paper">
  <div class="absolute inset-0 -z-20" aria-hidden="true">
    <video
      id="hero-video"
      class="h-full w-full object-cover opacity-70"
      muted
      autoplay
      loop
      playsinline
      preload="none"
      poster="/media/hero-poster.jpg"
      tabindex="-1"
    ></video>
    <div class="absolute inset-0 bg-gradient-to-t from-navy-950/90 via-navy-950/40 to-navy-950/35"></div>
  </div>

  <!-- Full-viewport span like the navbar — the wordmark scales with vw and
       must never be caged by the centered wrap, or it wraps on wide screens. -->
  <div class="relative flex flex-1 flex-col px-(--spacing-gutter) pt-20 pb-14 sm:pt-24 sm:pb-20">
    <!-- xnrgyclub-style oversized staggered wordmark over the video.
         mt-auto pins the kicker + headline cluster to the bottom of the
         hero, clear of the navbar, with open video above. -->
    <p
      data-hero-line
      class="mt-auto text-[0.6875rem] font-bold tracking-[0.25em] text-(--accent-muted) uppercase sm:text-sm"
    >
      {SITE.person} — Trial lawyer · Martial artist · TEDx speaker
    </p>

    <h1
      class="mt-3 flex flex-col gap-5 font-display font-normal tracking-[-0.04em] uppercase sm:gap-8"
    >
      <span
        data-hero-line
        class="block text-[clamp(3.25rem,13.5vw,13rem)] leading-[1.02] whitespace-nowrap"
      >
        The Karate
      </span>
      <span
        data-hero-line
        class="block self-end text-right text-[clamp(3.25rem,13.5vw,13rem)] leading-[1.02] whitespace-nowrap"
      >
        {/* Extra gap only between the two T's — an inline spacer, since
            letter-spacing can't target a single pair. */}
        At<span aria-hidden="true" class="inline-block w-[0.12em]"></span>torney<span
          class="text-(--accent-strong)">.</span>
      </span>
    </h1>
    {/* Hero CTAs and the legal-attribution note removed — the primary
        actions live in the header nav (Book to Speak / Need Legal Help?),
        and the firm attribution remains in the footer. */}
  </div>
</section>

<script>
  import '../../scripts/hero-video';
</script>
