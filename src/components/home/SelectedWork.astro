---
/**
 * Homepage 1 §1 — "Cases That Define The Work".
 *
 * Mirrors the reference's signature move: a deliberately unaligned grid
 * where each card sits at its own vertical offset, and the caption panel
 * slides up over the bottom of its image rather than sitting below it.
 * The third card breaks the pattern entirely — image left, copy right.
 */
import SectionHead from './SectionHead.astro';

// Card photography lives in /public (first.png, 2nd.png, third.png). These
// are the supplied images; update the alt text to describe the real photos
// before launch.
const work = [
  {
    title: 'Verdict, Not Settlement',
    body: 'Insurance companies bank on the fact that most lawyers would rather settle than try a case. I built my practice on the opposite instinct — when an offer falls short of what an injury actually cost someone, I prepare it for a jury and mean it.',
    img: '/first.png',
    alt: '[PLACEHOLDER photo] Courtroom advocacy',
    stats: [
      ['Focus', 'Trial Advocacy'],
      ['Posture', 'Ready for Court'],
    ],
  },
  {
    title: 'The Long Recovery',
    body: 'A serious injury does not end when the paperwork is filed. I stay with clients from the first phone call through the last hearing — because the person living with the outcome deserves a lawyer who treats the whole road, not just the case number.',
    img: '/2nd.png',
    alt: '[PLACEHOLDER photo] Serious-injury representation',
    stats: [
      ['Focus', 'Serious Injury'],
      ['Approach', 'Client-First'],
    ],
  },
];

const feature = {
  title: 'Discipline Under Pressure',
  body: 'Karate taught me that composure is a skill, not a temperament — you drill it until it holds when everything is on the line. That is the same discipline I bring to a courtroom: prepared, deliberate, and calm when the stakes are highest. The mat and the trial are two rooms that reward the same thing — showing up ready.',
  img: '/third.png',
  alt: '[PLACEHOLDER photo] Ibrahim in the dojo',
  stats: [
    ['Discipline', 'Karate'],
    ['Practice', 'Trial Law'],
  ],
};
---

<section class="on-dark bg-navy-950 text-paper">
  <div class="wrap section-pad">
    <SectionHead
      kicker="Selected work"
      title="Cases That Define The Work"
      meta="Archive / Trial Practice / 2026"
    />

    <!-- Offset pair: the second card drops to break the baseline. -->
    <div class="mt-14 grid gap-10 lg:grid-cols-2 lg:gap-8">
      {
        work.map((item, i) => (
          <article
            class:list={['relative', i === 1 && 'lg:mt-28']}
            data-reveal
            data-reveal-delay={i * 0.08}
          >
            <img
              src={item.img}
              alt={item.alt}
              width="1536"
              height="1024"
              loading="lazy"
              decoding="async"
              class="block aspect-[3/2] w-full rounded-xl object-cover"
            />
            <!-- Caption panel sits BELOW the image with a clear gap, matching
                 the image's full width (same left/right edges). -->
            <div class="mt-6 flex flex-col gap-5 rounded-lg bg-navy-900 p-6 sm:flex-row sm:items-start sm:justify-between sm:p-8">
              <div class="max-w-md">
                <h3 class="font-display text-2xl font-normal tracking-tight sm:text-3xl">
                  {item.title}
                </h3>
                <p class="mt-3 text-sm leading-relaxed text-navy-200">
                  {item.body}
                </p>
              </div>
              <dl class="shrink-0 space-y-1.5 font-mono text-xs text-(--accent-strong)">
                {item.stats.map(([k, v]) => (
                  <div class="flex gap-2">
                    <dt class="text-navy-300">{k}</dt>
                    <dd class="font-semibold">{v}</dd>
                  </div>
                ))}
              </dl>
            </div>
          </article>
        ))
      }
    </div>

    <!-- Pattern break: image left, copy panel right, with a clear gap
         between them. `items-stretch` makes the two columns the same
         height; the image fills that height (h-full) so it matches the
         panel, and the panel centres its copy within it. -->
    <article
      class="mt-12 grid items-stretch gap-6 lg:mt-20 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:gap-10"
      data-reveal
    >
      <img
        src={feature.img}
        alt={feature.alt}
        width="1536"
        height="1024"
        loading="lazy"
        decoding="async"
        class="block aspect-[3/2] h-full w-full rounded-xl object-cover lg:aspect-auto"
      />
      <div class="flex flex-col justify-center rounded-lg bg-navy-900 p-6 sm:p-10">
        <h3 class="font-display text-3xl font-normal tracking-tight sm:text-4xl">
          {feature.title}
        </h3>
        <p class="mt-4 max-w-lg text-sm leading-relaxed text-navy-200">
          {feature.body}
        </p>
        <dl class="mt-8 flex gap-10 font-mono text-xs text-(--accent-strong)">
          {
            feature.stats.map(([k, v]) => (
              <div>
                <dt class="text-navy-300">{k}</dt>
                <dd class="mt-1 font-semibold">{v}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </article>
  </div>
</section>
