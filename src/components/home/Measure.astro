---
/**
 * Homepage 1 §3 — "The Record In Numbers".
 *
 * Dark band that reuses the reference's oversized-numeral treatment: the
 * figures are set at display scale so the row reads as typography first and
 * data second, with a portrait column offset against it.
 */
import SectionHead from './SectionHead.astro';

// Figures are illustrative and easy to swap — replace the values with the
// real, verified counts before launch. The labels are final copy.
const figures = [
  { value: '20+', label: 'Years of discipline on the mat' },
  { value: '100+', label: 'Cases prepared and fought for injured clients' },
  { value: '50+', label: 'Stages, pulpits, and audiences reached' },
  { value: '1', label: 'Standard for every case — never negotiable' },
];
---

<section class="on-dark bg-navy-900 text-paper">
  <div class="wrap section-pad">
    <SectionHead
      kicker="By the numbers"
      title="The Record In Numbers"
      meta="Measured / Verified / 2026"
    />

    <!-- `items-stretch` makes both columns the same height; the image fills
         that height (h-full object-cover) so it matches the stats block on
         its left rather than towering over it. -->
    <div class="mt-14 grid items-stretch gap-12 lg:grid-cols-[minmax(0,1.35fr)_minmax(0,1fr)] lg:gap-16">
      <!-- Figures: two-up, packed to the top at their natural height. -->
      <dl class="grid grid-cols-2 content-start gap-x-8 gap-y-10">
        {
          figures.map((f, i) => (
            <div
              class="border-t border-white/15 pt-5"
              data-reveal
              data-reveal-delay={i * 0.06}
            >
              <dt class="sr-only">{f.label}</dt>
              <dd>
                <span class="block font-display text-[clamp(3rem,7vw,5.5rem)] leading-[0.85] font-extrabold tracking-tight text-(--accent-strong)">
                  {f.value}
                </span>
                <span class="mt-4 block max-w-[16rem] text-xs leading-relaxed text-navy-200">
                  {f.label}
                </span>
              </dd>
            </div>
          ))
        }
      </dl>

      <img
        src="/temp1.png"
        alt="[PLACEHOLDER photo] Ibrahim — portrait"
        width="1536"
        height="1024"
        loading="lazy"
        decoding="async"
        class="block aspect-[4/3] h-full w-full rounded-xl object-cover lg:aspect-auto"
        data-reveal
      />
    </div>

    <p class="mt-8 max-w-2xl text-sm leading-relaxed text-navy-200" data-reveal>
      Numbers only tell you where I have been. What matters is the standard
      behind them — the same one on the mat, in the courtroom, and at the
      pulpit: show up prepared, do the work honestly, and never give a
      client, a student, or an audience less than my full attention.
    </p>
  </div>
</section>
