---
/**
 * Homepage 1 — "Evolving Energy" split section (xnrgy reference).
 *
 * Two halves: a full-bleed photo on the left, and a dark navy panel on the
 * right carrying a big display headline, a mono paragraph, and underlined
 * arrow-link rows. The navy panel is lifted with a negative top margin so it
 * overlaps up into the previous (Introduction) section — the reference's
 * offset/layered seam.
 */
import { FIRM_URL } from '../../lib/site';

const links = [
  { label: 'Speaking & Events', href: '#' },
  { label: 'Request Ibrahim', href: FIRM_URL, firm: true },
];
---

<section class="relative">
  <div class="grid lg:grid-cols-2 lg:items-stretch">
    <!-- Left: full-bleed photo (no gutter, edge to edge). Starts at the
         normal section top. -->
    <div class="relative min-h-[22rem] lg:min-h-[42rem]">
      <img
        src="/book.jpg"
        alt="Ibrahim Awad in motion"
        class="absolute inset-0 h-full w-full object-cover"
        loading="lazy"
        decoding="async"
      />
    </div>

    <!-- Right: dark navy panel, lifted with a negative top margin so it
         overlaps up into the previous (Introduction) section — the
         reference's offset seam. The extra top padding (matching the overlap)
         recentres the content against the PHOTO's height, not the panel's, so
         the text lines up with the centre of the picture. -->
    <div
      class="on-dark relative z-10 flex flex-col justify-center bg-navy-950 px-(--spacing-gutter) py-16 text-paper sm:px-12 lg:-mt-24 lg:py-16 lg:pt-[10rem] lg:pr-20 lg:pl-28"
    >
      <div class="max-w-md">
        <h2
          class="font-display text-[clamp(2.5rem,5vw,4rem)] leading-[0.98] font-normal tracking-[-0.02em] uppercase"
          data-reveal
        >
          Evolving<br />Energy
        </h2>

        <p
          class="mt-10 font-mono text-[15px] leading-relaxed text-navy-100"
          data-reveal
        >
          Growth is not linear, and it is never only physical. It is the sum
          of many small movements — physical, mental, and moral — that
          accumulate over time. The discipline of the mat, the fight of the
          courtroom, and the words spoken from a stage are one practice, not
          three. Motion is not a moment; it is a mindset.
        </p>

        <ul class="mt-12 space-y-0">
          {
            links.map((link) => (
              <li data-reveal>
                <a
                  href={link.href}
                  data-firm-link={link.firm || undefined}
                  class="group flex items-center justify-between border-b border-white/20 py-4 font-display text-lg tracking-tight transition-colors hover:border-(--accent-muted)"
                >
                  <span>{link.label}</span>
                  <svg
                    class="h-5 w-5 shrink-0 text-navy-100 transition-[transform,color] duration-300 ease-(--ease-smooth) group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-(--accent-muted)"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M7 17 17 7M9 7h8v8" />
                  </svg>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
