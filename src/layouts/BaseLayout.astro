---
import { Font } from 'astro:assets';
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import Analytics from '../components/seo/Analytics.astro';
import Seo from '../components/seo/Seo.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** Extra classes on <body> (e.g. dark page background). */
  bodyClass?: string;
  /** Home hero: content flows under the transparent fixed header (no
   * spacer). Pages without a full-bleed hero keep the navy spacer. */
  heroOverlap?: boolean;
  /** Hide the shared site Header + Footer (page supplies its own chrome). */
  bareChrome?: boolean;
}

const {
  title,
  description,
  noindex,
  bodyClass = '',
  heroOverlap = false,
  bareChrome = false,
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#060d1a" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <Seo title={title} description={description} noindex={noindex} />
    <Font cssVariable="--font-archivo" preload />
    <Font cssVariable="--font-inter" preload />
    <Analytics />
    <noscript>
      <style>
        /* Without JS the scroll toggle can't run — keep the header solid. */
        .site-header {
          background-color: var(--color-navy-950);
        }
      </style>
    </noscript>
    <script is:inline>
      // Opening-animation gate. Runs before first paint so there is no
      // content flash. Plays on every load of a homepage variant (the
      // "opening the site" moment); other pages skip it, as does reduced
      // motion. The 4s timeout force-clears the overlay if the motion
      // module never starts, so a failed script can't trap the page.
      (function () {
        try {
          var path = location.pathname.replace(/\/$/, '') || '/';
          var homepages = ['/', '/homepage-2', '/homepage-3'];
          if (
            homepages.indexOf(path) === -1 ||
            matchMedia('(prefers-reduced-motion: reduce)').matches
          ) {
            return;
          }
          var root = document.documentElement;
          root.classList.add('ka-preload');
          setTimeout(function () {
            var p = document.getElementById('preloader');
            if (root.classList.contains('ka-preload') && (!p || !p.dataset.started)) {
              root.classList.remove('ka-preload');
              if (p) p.remove();
            }
          }, 4000);
        } catch (e) {
          /* matchMedia unavailable — skip the preloader */
        }
      })();
    </script>
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <div id="preloader" class="preloader" aria-hidden="true">
      {
        /* 4 full-height columns — each slides out vertically (alternating
           direction) in random order, xnrgy-style (see motion.ts).
           0.5vw oversize hides sub-pixel seams between columns. */
        Array.from({ length: 4 }).map((_, i) => (
          <div
            class="preloader-panel"
            style={`left:${i * 25}vw; top:0; width:25.5vw; height:100%;`}
          />
        ))
      }
      <p class="preloader-logo">
        <span>The <span class="text-(--accent)">Karate</span> Attorney</span>
      </p>
    </div>
    <a
      href="#main"
      class="sr-only-focusable fixed top-2 left-2 rounded-full bg-gold-400 font-bold text-navy-950"
    >
      Skip to content
    </a>
    {
      !bareChrome && (
        <div class="fixed inset-x-0 top-0 z-50">
          <Header />
        </div>
      )
    }
    {
      !bareChrome && !heroOverlap && (
        <div class="h-16 bg-navy-950 sm:h-20" aria-hidden="true" />
      )
    }
    <main id="main"><slot /></main>
    {!bareChrome && <Footer />}
    <script>
      import '../scripts/motion';
      import '../scripts/analytics';
    </script>
  </body>
</html>
