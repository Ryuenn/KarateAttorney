---
import { Font } from 'astro:assets';
import AnnouncementBar from '../components/layout/AnnouncementBar.astro';
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import Analytics from '../components/seo/Analytics.astro';
import Seo from '../components/seo/Seo.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** Extra classes on <body> (e.g. dark page background). */
  bodyClass?: string;
  /** Home hero: content flows under the transparent fixed header (no
   * spacer). Pages without a full-bleed hero keep the navy spacer. */
  heroOverlap?: boolean;
}

const {
  title,
  description,
  noindex,
  bodyClass = '',
  heroOverlap = false,
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#060d1a" />
    <Seo title={title} description={description} noindex={noindex} />
    <Font cssVariable="--font-archivo" preload />
    <Font cssVariable="--font-inter" preload />
    <Analytics />
    <noscript>
      <style>
        /* Without JS the scroll toggle can't run — keep the header solid. */
        .site-header {
          background-color: var(--color-navy-950);
        }
      </style>
    </noscript>
    <script is:inline>
      // First-visit preloader gate. Runs before first paint so there is no
      // content flash; skipped on repeat visits (session) and under
      // reduced motion. The 4s timeout force-clears the overlay if the
      // motion module never starts, so a failed script can't trap the page.
      (function () {
        try {
          if (
            sessionStorage.getItem('ka-preloaded') ||
            matchMedia('(prefers-reduced-motion: reduce)').matches
          ) {
            return;
          }
          var root = document.documentElement;
          root.classList.add('ka-preload');
          setTimeout(function () {
            var p = document.getElementById('preloader');
            if (root.classList.contains('ka-preload') && (!p || !p.dataset.started)) {
              root.classList.remove('ka-preload');
              if (p) p.remove();
            }
          }, 4000);
        } catch (e) {
          /* storage unavailable — skip the preloader */
        }
      })();
    </script>
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <div id="preloader" class="preloader" aria-hidden="true">
      <div class="preloader-panel"></div>
      <div class="preloader-panel"></div>
      <div class="preloader-panel"></div>
      <div class="preloader-panel"></div>
      <div class="preloader-panel"></div>
      <p class="preloader-logo">
        The <span class="text-gold-400">Karate</span> Attorney
      </p>
    </div>
    <a
      href="#main"
      class="sr-only-focusable fixed top-2 left-2 rounded-full bg-gold-400 font-bold text-navy-950"
    >
      Skip to content
    </a>
    <div class="fixed inset-x-0 top-0 z-50">
      <AnnouncementBar />
      <Header />
    </div>
    {!heroOverlap && <div class="h-24 bg-navy-950" aria-hidden="true"></div>}
    <main id="main"><slot /></main>
    <Footer />
    <script>
      import '../scripts/motion';
      import '../scripts/analytics';
    </script>
  </body>
</html>
