---
import { Font, Image } from 'astro:assets';
import karateLogo from '../assets/karate-logo.png';
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import Analytics from '../components/seo/Analytics.astro';
import Seo from '../components/seo/Seo.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** Extra classes on <body> (e.g. dark page background). */
  bodyClass?: string;
  /** Home hero: content flows under the transparent fixed header (no
   * spacer). Pages without a full-bleed hero keep the navy spacer. */
  heroOverlap?: boolean;
  /** Hide the shared site Header + Footer (page supplies its own chrome). */
  bareChrome?: boolean;
  /** Pin the footer to the bottom and let the last section scroll up to
   * reveal it (osvald-style curtain lift). Opt-in per page. */
  footerReveal?: boolean;
}

const {
  title,
  description,
  noindex,
  bodyClass = '',
  heroOverlap = false,
  bareChrome = false,
  footerReveal = false,
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#060d1a" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {/* Preload the Heavy display cut — it renders the LCP hero wordmark, so
        preloading avoids a fallback→Helvetica flash on the most prominent
        text. Light/Roman load on demand. */}
    <link
      rel="preload"
      href="/helvetica-neue-lt-pro/HelveticaNeueLTW0585Heavy.otf"
      as="font"
      type="font/otf"
      crossorigin
    />
    <Seo title={title} description={description} noindex={noindex} />
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-space-mono" preload />
    <Analytics />
    <noscript>
      <style>
        /* Without JS the scroll toggle can't run — keep the header solid. */
        .site-header {
          background-color: var(--color-navy-950);
        }
      </style>
    </noscript>
    <script is:inline>
      // Opening-animation gate. Runs before first paint so there is no
      // content flash. Plays on every page load — including navigation
      // between pages, so the panel reveal covers the swap instead of the
      // new page snapping in. Reduced motion skips it. The 4s timeout
      // force-clears the overlay if the motion module never starts, so a
      // failed script can't trap the page.
      (function () {
        try {
          if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
            return;
          }
          var root = document.documentElement;
          root.classList.add('ka-preload');
          setTimeout(function () {
            var p = document.getElementById('preloader');
            if (root.classList.contains('ka-preload') && (!p || !p.dataset.started)) {
              root.classList.remove('ka-preload');
              if (p) p.remove();
            }
          }, 4000);
        } catch (e) {
          /* matchMedia unavailable — skip the preloader */
        }
      })();
    </script>
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <div id="preloader" class="preloader" aria-hidden="true">
      {
        /* 4 full-height columns — each slides out vertically (alternating
           direction) in random order, xnrgy-style (see motion.ts).
           0.5vw oversize hides sub-pixel seams between columns. */
        Array.from({ length: 4 }).map((_, i) => (
          <div
            class="preloader-panel"
            style={`left:${i * 25}vw; top:0; width:25.5vw; height:100%;`}
          />
        ))
      }
      <div class="preloader-logo">
        <Image
          src={karateLogo}
          alt=""
          widths={[200, 320]}
          sizes="240px"
          class="h-auto w-[clamp(9rem,22vw,15rem)]"
          loading="eager"
        />
      </div>
    </div>
    <a
      href="#main"
      class="sr-only-focusable fixed top-2 left-2 rounded-full bg-(--accent) font-bold text-(--accent-ink)"
    >
      Skip to content
    </a>
    {
      !bareChrome && (
        <div class="fixed inset-x-0 top-0 z-50">
          <Header />
        </div>
      )
    }
    {
      !bareChrome && !heroOverlap && (
        <div class="h-16 bg-navy-950 sm:h-20" aria-hidden="true" />
      )
    }
    <main id="main" class={footerReveal ? 'footer-reveal-main' : undefined}>
      <slot />
    </main>
    {
      /* The footer renders unless bareChrome hides all shared chrome — but
         footerReveal opts a page back into the shared footer (with the
         curtain-reveal wrapper) even when it supplies its own header. */
      (footerReveal || !bareChrome) &&
        (footerReveal ? (
          <div class="footer-reveal">
            <Footer />
          </div>
        ) : (
          <Footer />
        ))
    }
    <script>
      import '../scripts/motion';
      import '../scripts/analytics';
    </script>
  </body>
</html>
